<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Layanan / Tindakan - RS Sakti Mandra Guna</title>
 
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
 
  <!-- CSS Bootstrap 5 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
 
  <style>
    :root {
      --bg-dark: #0d1117;
      --card-bg: #161b22;
      --sidebar-bg: #161b22;
      --border-color: #30363d;
      --accent-green: #2ea043;
      --accent-green-neon: #39FF14;
      --text-main: #c9d1d9;
      --text-heading: #ffffff;
      --text-sub: #8b949e;
    }

    body, html {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    .app-container {
      display: flex;
      min-height: 100vh;
    }

    /* SIDEBAR NAVIGASI */
    .sidebar {
      width: 250px;
      min-height: 100vh;
      background: var(--sidebar-bg);
      color: #ffffff;
      border-right: 1px solid var(--border-color);
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 20;
    }

    .sidebar-header {
      background: #010409;
      color: #ffffff;
      border-bottom: 1px solid var(--border-color);
      font-size: 0.85rem;
      padding: 16px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
      letter-spacing: 1px;
    }

    .logo-menu {
      height: 30px;
      width: auto;
    }

    .sidebar nav a {
      color: var(--text-sub);
      text-decoration: none;
      padding: 10px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 500;
      font-size: 0.875rem;
      transition: all 0.2s ease;
      border-left: 3px solid transparent;
    }

    .sidebar nav a:hover {
      background: rgba(255, 255, 255, 0.03);
      color: #ffffff;
    }

    .sidebar nav a.active {
      background: rgba(46, 160, 67, 0.15);
      color: var(--accent-green-neon);
      border-left-color: var(--accent-green-neon);
      font-weight: 600;
    }

    .sidebar-footer {
      padding: 14px 18px;
      font-size: 0.8rem;
      color: var(--text-sub);
      border-top: 1px solid var(--border-color);
      background: #010409;
    }

    /* MAIN CONTENT */
    .main-content {
      flex-grow: 1;
      position: relative;
      min-height: 100vh;
      background-color: var(--bg-dark);
    }

    .header-rs-center {
      background: var(--card-bg);
      padding: 18px 24px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
    }

    .logo-header {
      height: 48px;
      width: auto;
    }

    .header-title {
      color: var(--accent-green-neon);
      font-weight: 700;
      font-size: 1.35rem;
      margin: 0;
      letter-spacing: 0.5px;
    }

    .header-subtitle {
      color: var(--text-sub);
      font-size: 0.72rem;
      margin: 2px 0 0 0;
      letter-spacing: 1px;
    }

    .content-body {
      padding: 24px;
      position: relative;
    }

    .watermark-bg {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 450px;
      max-width: 70%;
      opacity: 0.04;
      pointer-events: none;
      z-index: 0;
    }

    .widget-container {
      border: 1px solid var(--border-color);
      background-color: var(--card-bg);
      border-radius: 12px;
      overflow: hidden;
      position: relative;
      z-index: 1;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .modal-label-custom {
      color: #39FF14 !important;
      font-weight: 600;
      font-size: 0.85rem;
      margin-bottom: 4px;
      display: block;
    }

    .form-control-dark, 
    input.form-control-dark, 
    textarea.form-control-dark {
      background-color: #010409 !important;
      border: 1px solid var(--border-color) !important;
      color: #ffffff !important;
      font-size: 0.9rem !important;
    }

    .form-control-dark:focus {
      background-color: #010409 !important;
      border-color: var(--accent-green-neon) !important;
      color: #ffffff !important;
      box-shadow: 0 0 0 0.2rem rgba(57, 255, 20, 0.2);
    }

    textarea.form-control-dark {
      resize: none !important;
    }

    .btn-green-neon {
      background-color: var(--accent-green);
      color: #ffffff;
      border: none;
      font-size: 0.8rem;
      font-weight: 600;
      padding: 6px 14px;
      border-radius: 6px;
    }

    .btn-green-neon:hover {
      background-color: #2c974b;
      color: #ffffff;
    }

    .modal-content-dark {
      background-color: #161b22;
      color: #ffffff !important;
      border: 1px solid var(--border-color);
      border-radius: 12px;
    }

    /* CARD GRID STYLES */
    .tindakan-card {
      background-color: #0d1117;
      border: 1px solid var(--border-color);
      border-radius: 10px;
      transition: all 0.2s ease;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .tindakan-card:hover {
      border-color: var(--accent-green);
      box-shadow: 0 4px 15px rgba(46, 160, 67, 0.15);
    }

    .card-title-neon {
      color: var(--accent-green-neon);
      font-weight: 700;
      font-size: 1rem;
    }

    .card-desc-text {
      color: #c9d1d9;
      font-size: 0.82rem;
      line-height: 1.4;
      min-height: 48px;
    }
  </style>
</head>
<body>

  <div class="app-container">
    <!-- SIDEBAR NAVIGASI -->
    <div class="sidebar">
      <div>
        <div class="sidebar-header">
          <img src="/image/logors.png" alt="Logo RS" class="logo-menu" onerror="this.style.display='none'">
          <span>MENU UTAMA</span>
        </div>
        <nav>
          <a href="/"><i class="bi bi-house-door"></i> Beranda</a>
          <a href="/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
          <a href="/booking"><i class="bi bi-calendar-check"></i> Booking / Pemesanan</a>
          <a href="/finalisasi"><i class="bi bi-check2-square"></i> Finalisasi</a>
          <a href="/riwayat-transaksi"><i class="bi bi-clock-history"></i> Riwayat Transaksi</a>
          <a href="/riwayat-pasien"><i class="bi bi-person-lines-fill"></i> Riwayat Pasien</a>
          <a href="/tindakan" class="active"><i class="bi bi-hospital"></i> Layanan / Tindakan</a>
          <a href="/dokter"><i class="bi bi-person-badge"></i> Dokter</a>
          <a href="/suster"><i class="bi bi-heart-pulse"></i> Suster</a>
          <a href="/lembur"><i class="bi bi-stopwatch"></i> Input Lembur</a>
          <a href="/payroll"><i class="bi bi-cash-stack"></i> Payroll / Gaji</a>
          <a href="/laporan"><i class="bi bi-file-earmark-bar-graph"></i> Laporan</a>
        </nav>
      </div>
     
      <div class="sidebar-footer d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-1 overflow-hidden me-2">
          <i class="bi bi-person-circle text-success me-1"></i>
          <strong class="text-white text-truncate" title="<%= typeof user !== 'undefined' && user ? (user.nama || user.username) : 'Administrator' %>">
            <%= typeof user !== 'undefined' && user ? (user.nama || user.username) : 'Administrator' %>
          </strong>
        </div>
        <a href="/logout" class="text-danger text-decoration-none" title="Keluar">
          <i class="bi bi-box-arrow-right fs-6"></i>
        </a>
      </div>
    </div>

    <!-- KONTEN UTAMA -->
    <div class="main-content">
      <div class="header-rs-center">
        <img src="/image/logors.png" alt="Logo RS" class="logo-header" onerror="this.style.display='none'">
        <div class="text-center">
          <h1 class="header-title">RS. SAKTI MANDRA GUNA</h1>
          <p class="header-subtitle">KHUSUS BEDAH PLASTIK, KECANTIKAN & TREATMENT</p>
        </div>
      </div>

      <div class="content-body">
        <img src="/image/logors.png" alt="Watermark RS" class="watermark-bg" onerror="this.style.display='none'">

        <div class="widget-container p-4">
          <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary">
            <div>
              <h5 class="fw-bold text-white mb-1">
                <i class="bi bi-journal-text text-success me-2"></i>Daftar Tarif Tindakan Medis
              </h5>
              <p class="text-muted small mb-0">Kelola nama tindakan, deskripsi, dan standar tarif layanan rumah sakit.</p>
            </div>
            <button type="button" class="btn btn-green-neon" data-bs-toggle="modal" data-bs-target="#modalTambahTindakan">
              <i class="bi bi-plus-circle me-1"></i> Tambah Tindakan
            </button>
          </div>

          <!-- GRID CONTAINER CARD -->
          <div class="row g-3">
            <% if (typeof tindakans === 'undefined' || tindakans.length === 0) { %>
              <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                Belum ada data jenis tindakan.
              </div>
            <% } else { %>
              <% tindakans.forEach(t => { %>
                <% const itemId = t._id || t.id; %>
                <div class="col-md-6 col-xl-4">
                  <div class="tindakan-card p-3">
                    <div>
                      <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="card-title-neon"><%= t.nama_tindakan %></span>
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 font-monospace">
                          Rp <%= Math.round(Number(t.harga_standar || 0)).toLocaleString('id-ID') %>
                        </span>
                      </div>
                      <p class="card-desc-text mb-3">
                        <%= t.deskripsi || 'Tidak ada deskripsi.' %>
                      </p>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top border-secondary">
                      <button type="button" class="btn btn-sm btn-outline-success px-3" data-bs-toggle="modal" data-bs-target="#modalEditTindakan<%= itemId %>">
                        <i class="bi bi-pencil-square me-1"></i> Edit
                      </button>
                      <!-- TOMBOL HAPUS MEMICU MODAL KONFIRMASI -->
                      <button type="button" class="btn btn-sm btn-outline-danger px-2" data-bs-toggle="modal" data-bs-target="#modalHapusTindakan<%= itemId %>" title="Hapus">
                        <i class="bi bi-trash"></i>
                      </button>
                    </div>
                  </div>
                </div>
              <% }); %>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- SEMUA MODAL EDIT & HAPUS DILETAKKAN DI LUAR KONTEN UTAMA -->
  <% if (typeof tindakans !== 'undefined' && tindakans.length > 0) { %>
    <% tindakans.forEach(t => { %>
      <% const itemId = t._id || t.id; %>
      
      <!-- MODAL EDIT -->
      <div class="modal fade" id="modalEditTindakan<%= itemId %>" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content modal-content-dark">
            <div class="modal-header border-secondary">
              <h5 class="modal-title fw-bold text-success fs-6">
                <i class="bi bi-pencil-square me-2"></i>Edit Tindakan
              </h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/tindakan/update/<%= itemId %>" method="POST">
              <div class="modal-body">
                <div class="mb-3">
                  <label class="modal-label-custom">Nama Tindakan</label>
                  <input type="text" name="nama_tindakan" class="form-control form-control-dark fw-bold" value="<%= t.nama_tindakan %>" required>
                </div>
                <div class="mb-3">
                  <label class="modal-label-custom">Deskripsi</label>
                  <textarea name="deskripsi" class="form-control form-control-dark" rows="3" style="resize: none;" placeholder="Keterangan singkat tindakan..."><%= t.deskripsi || '' %></textarea>
                </div>
                <div class="mb-3">
                  <label class="modal-label-custom">Harga Standar (Rp)</label>
                  <input type="number" name="harga_standar" class="form-control form-control-dark font-monospace" value="<%= t.harga_standar %>" required>
                </div>
              </div>
              <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                <button type="submit" class="btn btn-green-neon btn-sm px-4">Simpan Perubahan</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- MODAL KONFIRMASI HAPUS (DENGAN TOMBOL YA & TIDAK) -->
      <div class="modal fade" id="modalHapusTindakan<%= itemId %>" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
          <div class="modal-content modal-content-dark text-center p-3">
            <div class="modal-body">
              <i class="bi bi-exclamation-triangle text-warning fs-1 mb-2 d-block"></i>
              <h6 class="fw-bold text-white mb-2">Konfirmasi Hapus</h6>
              <p class="text-white small mb-3">Apakah Anda yakin ingin menghapus tindakan <strong class="text-success"><%= t.nama_tindakan %></strong>?</p>
              <div class="d-flex justify-content-center gap-2">
                <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Tidak</button>
                <a href="/tindakan/hapus/<%= itemId %>" class="btn btn-danger btn-sm px-3">Ya, Hapus</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  <% } %>

  <!-- MODAL TAMBAH TINDAKAN -->
  <div class="modal fade" id="modalTambahTindakan" tabindex="-1" aria-labelledby="modalTambahLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content modal-content-dark">
        <div class="modal-header border-secondary">
          <h5 class="modal-title fw-bold text-success fs-6" id="modalTambahLabel">
            <i class="bi bi-plus-circle me-2"></i>Tambah Jenis Tindakan
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/tindakan/tambah" method="POST">
          <div class="modal-body">
            <div class="mb-3">
              <label class="modal-label-custom">Nama Tindakan</label>
              <input type="text" name="nama_tindakan" class="form-control form-control-dark" required placeholder="misal: Operasi Rhinoplasty">
            </div>
            <div class="mb-3">
              <label class="modal-label-custom">Deskripsi</label>
              <textarea name="deskripsi" class="form-control form-control-dark" rows="3" style="resize: none;" placeholder="Keterangan singkat tindakan..."></textarea>
            </div>
            <div class="mb-3">
              <label class="modal-label-custom">Harga Standar (Rp)</label>
              <input type="number" name="harga_standar" class="form-control form-control-dark" required placeholder="0">
            </div>
          </div>
          <div class="modal-footer border-secondary">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
            <button type="submit" class="btn btn-green-neon btn-sm px-4">Simpan Tindakan</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Bootstrap Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>