<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RS Sakti Mandra Guna - Bedah Plastik & Kecantikan</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

  <style>
    :root {
      --primary-color: #0d1117;
      --card-bg: #161b22;
      --border-color: #30363d;
      --accent-green: #2ea043;
      --accent-neon: #39FF14;
      --text-main: #e6edf3;
      --text-sub: #9198a1;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--primary-color);
      color: var(--text-main);
    }

    .text-muted { color: var(--text-sub) !important; }

    /* TOP BAR & NAVBAR */
    .top-bar {
      background-color: #010409;
      font-size: 0.8rem;
      border-bottom: 1px solid var(--border-color);
    }

    .navbar-main {
      background-color: var(--card-bg);
      border-bottom: 1px solid var(--border-color);
    }

    .nav-link {
      color: #ffffff !important;
      font-weight: 500;
      padding: 8px 16px !important;
    }

    .nav-link:hover { color: var(--accent-neon) !important; }

    /* HERO SECTION */
    .hero-section {
      background: linear-gradient(rgba(13, 17, 23, 0.85), rgba(13, 17, 23, 0.95)), url('https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?q=80&w=1200') center/cover no-repeat;
      padding: 80px 0;
      border-bottom: 1px solid var(--border-color);
    }

    .badge-hero {
      background: rgba(46, 160, 67, 0.15);
      color: var(--accent-neon);
      border: 1px solid rgba(46, 160, 67, 0.3);
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 600;
    }

    /* ACTION BOXES */
    .action-box {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 24px;
      text-align: center;
      transition: all 0.3s ease;
      height: 100%;
      text-decoration: none;
      display: block;
    }

    .action-box:hover {
      transform: translateY(-5px);
      border-color: var(--accent-green);
    }

    .action-box i {
      font-size: 2.2rem;
      color: var(--accent-green);
      margin-bottom: 12px;
      display: block;
    }

    /* FEATURE CARDS */
    .feature-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 24px;
      height: 100%;
    }

    .btn-neon {
      background-color: var(--accent-green);
      color: #ffffff;
      font-weight: 600;
      border: none;
    }

    .btn-neon:hover {
      background-color: #2c974b;
      color: #ffffff;
    }

    .btn-outline-neon {
      border: 1px solid var(--accent-green);
      color: var(--accent-neon);
    }

    .btn-outline-neon:hover {
      background-color: var(--accent-green);
      color: #ffffff;
    }
  </style>
</head>
<body>

  <!-- TOP BAR -->
  <div class="top-bar py-2 text-white-50">
    <div class="container d-flex justify-content-between align-items-center">
      <div>
        <i class="bi bi-telephone-fill text-success me-2"></i> Emergency Call: <strong>(021) 555-9999</strong>
        <span class="mx-3 d-none d-md-inline">|</span>
        <span class="d-none d-md-inline"><i class="bi bi-clock-fill text-success me-2"></i> 24 Jam Pelayanan Darurat & Konsultasi</span>
      </div>
      <div>
        <% if (typeof user !== 'undefined' && user) { %>
          <div class="d-flex align-items-center gap-2">
            <!-- Tombol Pintasan Portal Admin -->
            <% if (user.role === 'administrator' || user.role === 'admin' || user.role === 'finance' || user.role === 'kasir') { %>
              <a href="/dashboard" class="btn btn-sm btn-success px-2 py-0 fs-7 fw-semibold" title="Portal Admin">
                <i class="bi bi-speedometer2"></i> Portal Admin
              </a>
            <% } %>

            <span class="small text-light ms-2 me-1"><i class="bi bi-person-circle text-success me-1"></i> <%= user.nama || user.username %></span>
            <a href="/logout" class="btn btn-sm btn-outline-danger px-2 py-0 fs-7" title="Keluar">
              <i class="bi bi-box-arrow-right"></i> Logout
            </a>
          </div>
        <% } else { %>
          <button type="button" class="btn btn-sm btn-outline-neon fw-semibold px-3" data-bs-toggle="modal" data-bs-target="#loginModal">
            <i class="bi bi-box-arrow-in-right me-1"></i> Login Sistem
          </button>
        <% } %>
      </div>
    </div>
  </div>

  <!-- NAVBAR UTAMA -->
  <nav class="navbar navbar-expand-lg navbar-main sticky-top">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center" href="/">
        <img src="/image/logors.png" alt="Logo RS" height="42" class="me-3" onerror="this.style.display='none'">
        <div>
          <span class="fw-bold text-white fs-5 d-block">RS SAKTI MANDRA GUNA</span>
          <small class="text-muted" style="font-size: 0.65rem; letter-spacing: 1px;">BEDAH PLASTIK & KECANTIKAN</small>
        </div>
      </a>
      <button class="navbar-toggler navbar-dark" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item"><a class="nav-link active" href="/">Beranda</a></li>
          <li class="nav-item"><a class="nav-link" href="/layanan">Layanan & Treatment</a></li>
          <li class="nav-item"><a class="nav-link" href="/cek-dokter">Cari Dokter</a></li>
          <li class="nav-item"><a class="nav-link" href="/fasilitas">Fasilitas</a></li>
          <li class="nav-item ms-lg-3">
            <% if (typeof user !== 'undefined' && user) { %>
              <button type="button" class="btn btn-neon btn-sm px-3" data-bs-toggle="modal" data-bs-target="#modalBooking">
                <i class="bi bi-calendar-check me-1"></i> Buat Janji Temu
              </button>
            <% } else { %>
              <button type="button" class="btn btn-neon btn-sm px-3" data-bs-toggle="modal" data-bs-target="#loginModal">
                <i class="bi bi-calendar-check me-1"></i> Buat Janji Temu
              </button>
            <% } %>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- HERO SECTION -->
  <section class="hero-section">
    <div class="container text-center text-lg-start">
      <div class="row align-items-center">
        <div class="col-lg-8 mx-auto text-center">
          <span class="badge-hero mb-3 d-inline-block">Pusat Bedah Plastik & Aesthetic Utama</span>
          <h1 class="display-5 fw-bold text-white mb-3">Layanan Spesialis Bedah Rekonstruksi & Estetika</h1>
          <p class="text-muted lead mb-4">Didukung oleh tim dokter berpengalaman dan teknologi medis terkini untuk memberikan perawatan aman dan presisi tinggi.</p>
          <% if (typeof user !== 'undefined' && user) { %>
            <button type="button" class="btn btn-neon btn-lg px-4" data-bs-toggle="modal" data-bs-target="#modalBooking">
              <i class="bi bi-calendar-check me-2"></i> Janji Konsultasi
            </button>
          <% } else { %>
            <button type="button" class="btn btn-neon btn-lg px-4" data-bs-toggle="modal" data-bs-target="#loginModal">
              <i class="bi bi-calendar-check me-2"></i> Janji Konsultasi
            </button>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- QUICK ACTION GRID -->
  <section class="py-5 bg-dark">
    <div class="container">
      <div class="row g-4">
        <div class="col-md-3">
          <a href="/cek-dokter" class="action-box">
            <i class="bi bi-person-badge"></i>
            <h6 class="fw-bold text-white mb-1">Cek Dokter</h6>
            <small class="text-muted">Jadwal & Spesialisasi</small>
          </a>
        </div>
        <div class="col-md-3">
          <% if (typeof user !== 'undefined' && user) { %>
            <a href="#" class="action-box" data-bs-toggle="modal" data-bs-target="#modalBooking">
              <i class="bi bi-calendar-plus"></i>
              <h6 class="fw-bold text-white mb-1">Buat Janji Temu</h6>
              <small class="text-muted">Booking Online Cepat</small>
            </a>
          <% } else { %>
            <a href="#" class="action-box" data-bs-toggle="modal" data-bs-target="#loginModal">
              <i class="bi bi-calendar-plus"></i>
              <h6 class="fw-bold text-white mb-1">Buat Janji Temu</h6>
              <small class="text-muted">Booking Online Cepat</small>
            </a>
          <% } %>
        </div>
        <div class="col-md-3">
          <a href="/layanan" class="action-box">
            <i class="bi bi-clipboard2-pulse"></i>
            <h6 class="fw-bold text-white mb-1">Daftar Tindakan</h6>
            <small class="text-muted">Estimasi Tarif & Prosedur</small>
          </a>
        </div>
        <div class="col-md-3">
          <a href="/fasilitas" class="action-box">
            <i class="bi bi-hospital"></i>
            <h6 class="fw-bold text-white mb-1">Fasilitas Rumah Sakit</h6>
            <small class="text-muted">IGD, OK, & Rawat Inap</small>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION EXCELLENCE -->
  <section class="py-5">
    <div class="container">
      <div class="text-center mb-5">
        <h3 class="fw-bold text-white">Layanan & Center of Excellence</h3>
        <p class="text-muted">Perawatan medis eksklusif yang dirancang khusus sesuai kebutuhan kesehatan dan estetika Anda.</p>
      </div>
      <div class="row g-4">
        <div class="col-md-4">
          <div class="feature-card">
            <i class="bi bi-scissors text-success fs-2 mb-3 d-block"></i>
            <h5 class="fw-bold text-white mb-2">Bedah (Surgical)</h5>
            <p class="text-muted small mb-0">Prosedur rekonstruksi dan estetika seperti Rhinoplasty, Facelift, Liposuction, dan Blepharoplasty dengan standar medis tertinggi.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="feature-card">
            <i class="bi bi-stars text-success fs-2 mb-3 d-block"></i>
            <h5 class="fw-bold text-white mb-2">Treatment (Non-Surgical)</h5>
            <p class="text-muted small mb-0">Perawatan Laser Skin Rejuvenation, Botox, Filler, Skin Booster, dan Thread Lift tanpa pembedahan untuk hasil instan dan aman.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="feature-card">
            <i class="bi bi-chat-heart text-success fs-2 mb-3 d-block"></i>
            <h5 class="fw-bold text-white mb-2">Konsultasi / Kontrol</h5>
            <p class="text-muted small mb-0">Layanan konsultasi pra-tindakan dengan Dokter Spesialis Bedah Plastik serta pendampingan kontrol pasca-bedah intensif.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MODAL LOGIN POP-UP -->
  <div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content text-light" style="background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px;">
        <div class="modal-header border-bottom-0 pb-0">
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body px-4 pb-4">
          <div class="text-center mb-4">
            <img src="/image/logors.png" alt="Logo RS" height="50" class="mb-2" onerror="this.style.display='none'">
            <h5 class="fw-bold text-white mb-0">RS SAKTI MANDRA GUNA</h5>
            <small class="text-muted" style="font-size: 0.75rem; letter-spacing: 1px;">BEDAH PLASTIK & KECANTIKAN</small>
          </div>
          <div id="loginAlert" class="alert alert-danger text-center py-2 fs-6 mb-3 d-none"></div>
          <form id="formLoginPopup">
            <div class="mb-3">
              <label class="form-label text-light small fw-semibold">Username / Email</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-person"></i></span>
                <input type="text" id="popupUsername" name="username" class="form-control bg-dark border-secondary text-white" placeholder="Masukkan username" required>
              </div>
            </div>
            <div class="mb-4">
              <label class="form-label text-light small fw-semibold mb-0">Kata Sandi</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-lock"></i></span>
                <input type="password" id="popupPassword" name="password" class="form-control bg-dark border-secondary text-white" placeholder="Masukkan kata sandi" required>
              </div>
            </div>
            <button type="submit" class="btn btn-neon w-100 py-2 fw-semibold mb-3">
              Masuk <i class="bi bi-box-arrow-in-right ms-1"></i>
            </button>
            <div class="text-center pt-3 border-top border-secondary">
              <span class="small text-muted">Belum memiliki akun?</span>
              <a href="#" class="small fw-bold text-success text-decoration-none ms-1" data-bs-toggle="modal" data-bs-target="#registerModal" data-bs-dismiss="modal">Daftar Sekarang</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL REGISTER POP-UP -->
  <div class="modal fade" id="registerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content text-light" style="background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px;">
        <div class="modal-header border-bottom-0 pb-0">
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body px-4 pb-4">
          <div class="text-center mb-4">
            <img src="/image/logors.png" alt="Logo RS" height="50" class="mb-2" onerror="this.style.display='none'">
            <h5 class="fw-bold text-white mb-0">PENDAFTARAN AKUN BARU</h5>
            <small class="text-muted" style="font-size: 0.75rem; letter-spacing: 1px;">RS SAKTI MANDRA GUNA</small>
          </div>
          <div id="registerAlert" class="alert alert-danger text-center py-2 fs-6 mb-3 d-none"></div>
          <form id="formRegisterPopup">
            <div class="mb-3">
              <label class="form-label text-light small fw-semibold">Nama Lengkap</label>
              <input type="text" name="nama" class="form-control bg-dark border-secondary text-white" placeholder="Masukkan nama lengkap" required>
            </div>
            <div class="mb-3">
              <label class="form-label text-light small fw-semibold">Username</label>
              <input type="text" name="username" class="form-control bg-dark border-secondary text-white" placeholder="Buat username" required>
            </div>
            <div class="mb-4">
              <label class="form-label text-light small fw-semibold">Kata Sandi</label>
              <input type="password" name="password" class="form-control bg-dark border-secondary text-white" placeholder="Buat kata sandi" required>
            </div>
            <button type="submit" class="btn btn-neon w-100 py-2 fw-semibold mb-3">
              Daftar <i class="bi bi-person-plus ms-1"></i>
            </button>
            <div class="text-center pt-3 border-top border-secondary">
              <span class="small text-muted">Sudah punya akun?</span>
              <a href="#" class="small fw-bold text-success text-decoration-none ms-1" data-bs-toggle="modal" data-bs-target="#loginModal" data-bs-dismiss="modal">Masuk di sini</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- INCLUDE ONLINE BOOKING MODAL (PARSIAL TERPUSAT) -->
  <%- include('onlinebooking') %>

  <!-- FOOTER -->
  <footer class="bg-dark text-white-50 pt-5 pb-3 border-top border-secondary">
    <div class="container text-center small">
      <p>&copy; 2026 RS Sakti Mandra Guna. All Rights Reserved.</p>
    </div>
  </footer>

  <!-- JS: Bootstrap & SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <script>
    // Handling AJAX Login (Dialihkan kembali ke Homepage '/' setelah sukses login)
    const formLoginPopup = document.getElementById('formLoginPopup');
    if (formLoginPopup) {
      formLoginPopup.addEventListener('submit', async function(e) {
        e.preventDefault();
        const username = document.getElementById('popupUsername').value;
        const password = document.getElementById('popupPassword').value;
        const alertBox = document.getElementById('loginAlert');
        if (alertBox) alertBox.classList.add('d-none');

        try {
          const response = await fetch('/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ username, password })
          });
          const result = await response.json();
          if (response.ok && result.success) {
            // Mengarahkan kembali ke homepage '/' (atau portal admin jika user administrator/admin khusus)
            window.location.href = (result.redirectUrl && (result.redirectUrl.includes('/dashboard') && ['administrator', 'admin', 'finance', 'kasir'].includes(result.role))) ? result.redirectUrl : '/';
          } else {
            if (alertBox) {
              alertBox.innerText = result.message || 'Username atau password salah.';
              alertBox.classList.remove('d-none');
            }
          }
        } catch (err) {
          if (alertBox) {
            alertBox.innerText = 'Terjadi kesalahan sistem server.';
            alertBox.classList.remove('d-none');
          }
        }
      });
    }

    // Handling AJAX Register dengan Event Delegation (Anti-Gagal / Mencegah Lari ke /register)
    document.addEventListener('submit', async function(e) {
      if (e.target && e.target.id === 'formRegisterPopup') {
        e.preventDefault(); // Mencegah total perpindahan halaman atau reload otomatis

        const form = e.target;
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        const alertBox = document.getElementById('registerAlert');
        if (alertBox) alertBox.classList.add('d-none');

        try {
          const response = await fetch('/register', {
            method: 'POST',
            headers: { 
              'Content-Type': 'application/json', 
              'Accept': 'application/json' 
            },
            body: JSON.stringify(data)
          });
          
          const result = await response.json();
          
          if (response.ok && result.success) {
            // Tutup modal register
            const registerModalEl = document.getElementById('registerModal');
            if (registerModalEl) {
              const registerModal = bootstrap.Modal.getInstance(registerModalEl);
              if (registerModal) registerModal.hide();
            }

            // Tampilkan SweetAlert2 Dark Mode yang elegan
            Swal.fire({
              icon: 'success',
              title: 'Pendaftaran Berhasil!',
              text: result.message || 'Akun Anda berhasil dibuat. Silakan masuk.',
              background: '#161b22',
              color: '#c9d1d9',
              confirmButtonColor: '#2ea043'
            }).then(() => {
              // Buka modal login otomatis setelah pop-up ditutup
              const loginModalEl = document.getElementById('loginModal');
              if (loginModalEl) {
                const loginModal = new bootstrap.Modal(loginModalEl);
                loginModal.show();
              }
            });
          } else {
            if (alertBox) {
              alertBox.innerText = result.message || 'Gagal melakukan pendaftaran.';
              alertBox.classList.remove('d-none');
            }
          }
        } catch (err) {
          if (alertBox) {
            alertBox.innerText = 'Terjadi kesalahan pada sistem server.';
            alertBox.classList.remove('d-none');
          }
        }
      }
    });
  </script>
</body>
</html>