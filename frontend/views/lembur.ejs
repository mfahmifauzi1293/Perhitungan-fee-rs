<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manajemen Lembur Pegawai - RS Sakti Mandra Guna</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- CSS Bootstrap 5 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  
  <style>
    :root {
      --bg-dark: #0d1117;
      --card-bg: #161b22;
      --sidebar-bg: #161b22;
      --border-color: #30363d;
      --accent-green: #2ea043;
      --accent-green-neon: #39FF14;
      --text-main: #c9d1d9;
      --text-heading: #ffffff;
      --text-sub: #8b949e;
    }

    body, html {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    .app-container {
      display: flex;
      min-height: 100vh;
    }

    /* SIDEBAR */
    .sidebar {
      width: 250px;
      min-height: 100vh;
      background: var(--sidebar-bg);
      color: #ffffff;
      border-right: 1px solid var(--border-color);
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 20;
    }

    .sidebar-header {
      background: #010409;
      color: #ffffff;
      border-bottom: 1px solid var(--border-color);
      font-size: 0.85rem;
      padding: 16px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
      letter-spacing: 1px;
    }

    .logo-menu {
      height: 30px;
      width: auto;
    }

    .sidebar nav a {
      color: var(--text-sub);
      text-decoration: none;
      padding: 10px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 500;
      font-size: 0.875rem;
      transition: all 0.2s ease;
      border-left: 3px solid transparent;
    }

    .sidebar nav a:hover {
      background: rgba(255, 255, 255, 0.03);
      color: #ffffff;
    }

    .sidebar nav a.active {
      background: rgba(46, 160, 67, 0.15);
      color: var(--accent-green-neon);
      border-left-color: var(--accent-green-neon);
      font-weight: 600;
    }

    .sidebar-footer {
      padding: 14px 18px;
      font-size: 0.8rem;
      color: var(--text-sub);
      border-top: 1px solid var(--border-color);
      background: #010409;
    }

    /* MAIN CONTENT */
    .main-content {
      flex-grow: 1;
      position: relative;
      min-height: 100vh;
      background-color: var(--bg-dark);
    }

    .header-rs-center {
      background: var(--card-bg);
      padding: 18px 24px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
    }

    .logo-header {
      height: 48px;
      width: auto;
    }

    .header-title {
      color: var(--accent-green-neon);
      font-weight: 700;
      font-size: 1.35rem;
      margin: 0;
      letter-spacing: 0.5px;
    }

    .header-subtitle {
      color: var(--text-sub);
      font-size: 0.72rem;
      margin: 2px 0 0 0;
      letter-spacing: 1px;
    }

    .content-body {
      padding: 24px;
      position: relative;
    }

    .watermark-bg {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 450px;
      max-width: 70%;
      opacity: 0.04;
      pointer-events: none;
      z-index: 0;
    }

    .widget-container {
      border: 1px solid var(--border-color);
      background-color: var(--card-bg);
      border-radius: 12px;
      overflow: hidden;
      position: relative;
      z-index: 1;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .widget-header {
      background-color: rgba(255, 255, 255, 0.02);
      color: var(--text-heading);
      padding: 14px 20px;
      font-weight: 600;
      font-size: 0.95rem;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* TABLE DARK CUSTOM */
    .table-dark-custom {
      --bs-table-bg: transparent !important;
      --bs-table-color: var(--text-main) !important;
      width: 100%;
      margin-bottom: 0;
      font-size: 0.875rem;
    }

    .table-dark-custom th {
      background-color: rgba(0, 0, 0, 0.25) !important;
      color: var(--accent-green-neon) !important;
      border-bottom: 1px solid var(--border-color) !important;
      padding: 12px 16px;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .table-dark-custom td {
      background-color: transparent !important;
      color: var(--text-main) !important;
      border-bottom: 1px solid var(--border-color) !important;
      padding: 12px 16px;
    }

    .table-dark-custom tbody tr:hover {
      background-color: rgba(255, 255, 255, 0.02) !important;
    }

    /* FORM & BUTTONS */
    .form-control-dark, .form-select-dark {
      background-color: #0d1117 !important;
      border: 1px solid var(--border-color) !important;
      color: #ffffff !important;
      font-size: 0.875rem;
      color-scheme: dark;
    }

    .form-control-dark:focus, .form-select-dark:focus {
      border-color: var(--accent-green) !important;
      box-shadow: 0 0 0 0.25rem rgba(46, 160, 67, 0.25);
      color: #fff;
    }

    .btn-neon {
      background-color: var(--accent-green);
      color: #fff;
      font-weight: 600;
      border: none;
      transition: all 0.2s ease;
    }

    .btn-neon:hover {
      background-color: #238636;
      color: #fff;
    }
  </style>
</head>
<body>

  <div class="app-container">
    <!-- SIDEBAR -->
    <div class="sidebar">
      <div>
        <div class="sidebar-header">
          <img src="/image/logors.png" alt="Logo RS" class="logo-menu" onerror="this.style.display='none'">
          <span>MENU UTAMA</span>
        </div>
        <nav>
          <a href="/"><i class="bi bi-house-door"></i> Beranda</a>
          <a href="/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
          <a href="/booking"><i class="bi bi-calendar-check"></i> Booking / Pemesanan</a>
          <a href="/finalisasi"><i class="bi bi-check2-square"></i> Finalisasi</a>
          <a href="/riwayat-transaksi"><i class="bi bi-clock-history"></i> Riwayat Transaksi</a>
          <a href="/riwayat-pasien"><i class="bi bi-person-lines-fill"></i> Riwayat Pasien</a>
          <a href="/tindakan"><i class="bi bi-hospital"></i> Layanan / Tindakan</a>
          <a href="/dokter"><i class="bi bi-person-badge"></i> Dokter</a>
          <a href="/suster"><i class="bi bi-heart-pulse"></i> Suster</a>
          <a href="/lembur" class="active"><i class="bi bi-stopwatch"></i> Input Lembur</a>
          <a href="/payroll"><i class="bi bi-cash-stack"></i> Payroll / Gaji</a>
          <a href="/laporan"><i class="bi bi-file-earmark-bar-graph"></i> Laporan</a>
        </nav>
      </div>
      
      <div class="sidebar-footer d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-1 overflow-hidden me-2">
          <i class="bi bi-person-circle text-success me-1"></i>
          <strong class="text-white text-truncate" title="<%= typeof user !== 'undefined' && user ? (user.nama || user.username) : 'Administrator' %>">
            <%= typeof user !== 'undefined' && user ? (user.nama || user.username) : 'Administrator' %>
          </strong>
        </div>
        <a href="/logout" class="text-danger text-decoration-none" title="Keluar">
          <i class="bi bi-box-arrow-right fs-6"></i>
        </a>
      </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
      <div class="header-rs-center">
        <img src="/image/logors.png" alt="Logo RS" class="logo-header" onerror="this.style.display='none'">
        <div class="text-center">
          <h1 class="header-title">RS. SAKTI MANDRA GUNA</h1>
          <p class="header-subtitle">MANAJEMEN LEMBUR PEGAWAI & KARYAWAN</p>
        </div>
      </div>

      <div class="content-body">
        <img src="/image/logors.png" alt="Watermark RS" class="watermark-bg" onerror="this.style.display='none'">

        <!-- Tabel Rekapitulasi & Filter -->
        <div class="widget-container">
          <div class="widget-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="bi bi-stopwatch text-info me-2"></i> Rekapitulasi Data Lembur Pegawai</span>
            
            <div class="d-flex align-items-center gap-3">
              <!-- Filter Periode Bulan & Tahun -->
              <% const namaBulan = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember']; %>
              <form action="/lembur" method="GET" class="d-flex align-items-center gap-2">
                <select name="bulan" class="form-select form-select-dark form-select-sm" onchange="this.form.submit()">
                  <% for(let i=1; i<=12; i++) { %>
                    <option value="<%= i %>" <%= i === Number(bulan) ? 'selected' : '' %>><%= namaBulan[i-1] %></option>
                  <% } %>
                </select>
                <input type="number" name="tahun" class="form-control form-control-dark form-control-sm" style="width: 85px;" value="<%= tahun %>" onchange="this.form.submit()">
              </form>

              <!-- Tombol Pemicu Modal Pop-up -->
              <button type="button" class="btn btn-neon btn-sm" data-bs-toggle="modal" data-bs-target="#modalTambahLembur">
                <i class="bi bi-plus-circle me-1"></i> Input Jam Lembur
              </button>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-dark-custom align-middle">
              <thead>
                <tr>
                  <th class="text-center" style="width: 50px;">No</th>
                  <th>NIK</th>
                  <th>Nama Pegawai</th>
                  <th>Jabatan</th>
                  <th>Jumlah Jam</th>
                  <th>Nominal Lembur</th>
                  <th>Keterangan</th>
                  <th class="text-center">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% if (lemburs.length === 0) { %>
                  <tr>
                    <td colspan="8" class="text-center py-4 text-muted">Belum ada data lembur pada periode ini.</td>
                  </tr>
                <% } else { %>
                  <% lemburs.forEach((l, idx) => { %>
                    <tr>
                      <td class="text-center"><%= idx + 1 %></td>
                      <td><span class="font-monospace text-info"><%= l.nik %></span></td>
                      <td><strong class="text-white"><%= l.nama_karyawan %></strong></td>
                      <td><%= l.jabatan %></td>
                      <td><span class="badge bg-secondary"><%= l.jumlah_jam %> Jam</span></td>
                      <td class="fw-bold text-success font-monospace">Rp <%= Number(l.nominal_lembur || 0).toLocaleString('id-ID') %></td>
                      <td><small class="text-truncate d-inline-block" style="max-width: 180px;" title="<%= l.keterangan %>"><%= l.keterangan %></small></td>
                      <td class="text-center">
                        <a href="/lembur/delete/<%= l.id %>?bulan=<%= bulan %>&tahun=<%= tahun %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Yakin ingin menghapus data lembur ini?')">
                          <i class="bi bi-trash"></i>
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- MODAL POP-UP INPUT LEMBUR -->
  <div class="modal fade" id="modalTambahLembur" tabindex="-1" aria-labelledby="modalTambahLemburLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content" style="background-color: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-main);">
        <div class="modal-header border-bottom border-secondary">
          <h5 class="modal-title text-white fs-6 fw-bold" id="modalTambahLemburLabel">
            <i class="bi bi-plus-circle text-success me-2"></i> Input Jam Lembur Pegawai
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/lembur/store" method="POST">
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label text-white small fw-semibold">Pilih Pegawai / Karyawan (Staf & Suster)</label>
              <select name="nik" class="form-select form-select-dark" required>
                <option value="">-- Pilih Pegawai --</option>
                <% karyawans.forEach(k => { %>
                  <option value="<%= k.nik %>"><%= k.nama_karyawan %> (<%= k.jabatan %> - Rp <%= Number(k.gaji_pokok || 0).toLocaleString('id-ID') %>)</option>
                <% }) %>
              </select>
            </div>

            <div class="row mb-3">
              <div class="col-6">
                <label class="form-label text-white small fw-semibold">Bulan</label>
                <select name="bulan" class="form-select form-select-dark" required>
                  <% for(let i=1; i<=12; i++) { %>
                    <option value="<%= i %>" <%= i === Number(bulan) ? 'selected' : '' %>><%= namaBulan[i-1] %></option>
                  <% } %>
                </select>
              </div>
              <div class="col-6">
                <label class="form-label text-white small fw-semibold">Tahun</label>
                <input type="number" name="tahun" class="form-control form-control-dark" value="<%= tahun %>" required>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label text-white small fw-semibold">Jumlah Jam Lembur (Jam)</label>
              <input type="number" step="0.5" name="jumlah_jam" class="form-control form-control-dark" placeholder="Contoh: 5.5" required>
              <small class="text-muted" style="font-size: 0.75rem;">*Rumus otomatis: (1 / 173) × Gaji Pokok × Jam</small>
            </div>

            <div class="mb-3">
              <label class="form-label text-white small fw-semibold">Keterangan / Alasan Lembur</label>
              <textarea name="keterangan" class="form-control form-control-dark" rows="2" placeholder="Contoh: Shift tambahan penanganan pasien darurat"></textarea>
            </div>
          </div>
          <div class="modal-footer border-top border-secondary">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Tutup</button>
            <button type="submit" class="btn btn-neon btn-sm px-4"><i class="bi bi-save me-1"></i> Simpan Lembur</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Bootstrap Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>