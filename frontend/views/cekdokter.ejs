<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Jadwal & Cek Dokter - RS Sakti Mandra Guna</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

  <style>
    :root {
      --primary-color: #0d1117;
      --card-bg: #161b22;
      --border-color: #30363d;
      --accent-green: #2ea043;
      --accent-neon: #39FF14;
      --text-main: #e6edf3;
      --text-sub: #9198a1;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--primary-color);
      color: var(--text-main);
    }

    .text-muted { color: var(--text-sub) !important; }

    /* TOP BAR & NAVBAR */
    .top-bar {
      background-color: #010409;
      font-size: 0.8rem;
      border-bottom: 1px solid var(--border-color);
    }

    .navbar-main {
      background-color: var(--card-bg);
      border-bottom: 1px solid var(--border-color);
    }

    .nav-link {
      color: #ffffff !important;
      font-weight: 500;
      padding: 8px 16px !important;
    }

    .nav-link:hover { color: var(--accent-neon) !important; }

    /* PAGE HEADER */
    .page-header {
      background: linear-gradient(180deg, #161b22 0%, #0d1117 100%);
      padding: 40px 0 25px 0;
      border-bottom: 1px solid var(--border-color);
    }

    .section-title {
      color: #ffffff;
      font-weight: 700;
      position: relative;
      display: inline-block;
    }

    .section-title::after {
      content: '';
      position: absolute;
      width: 50%;
      height: 3px;
      background: var(--accent-neon);
      bottom: -8px;
      left: 25%;
    }

    /* CARD DOKTER STYLES */
    .doctor-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 24px;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .doctor-card:hover {
      transform: translateY(-5px);
      border-color: var(--accent-green);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    }

    .doctor-avatar {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--accent-green);
      background-color: #21262d;
    }

    .schedule-box {
      background-color: #0d1117;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 12px;
      font-size: 0.85rem;
    }

    .btn-neon {
      background-color: var(--accent-green);
      color: #ffffff;
      font-weight: 600;
      border: none;
    }

    .btn-neon:hover {
      background-color: #2c974b;
      color: #ffffff;
    }

    .btn-outline-neon {
      border: 1px solid var(--accent-green);
      color: var(--accent-neon);
    }

    .btn-outline-neon:hover {
      background-color: var(--accent-green);
      color: #ffffff;
    }
  </style>
</head>
<body>

  <!-- TOP BAR -->
  <div class="top-bar py-2 text-white-50">
    <div class="container d-flex justify-content-between align-items-center">
      <div>
        <i class="bi bi-telephone-fill text-success me-2"></i> Emergency Call: <strong>(021) 555-9999</strong>
        <span class="mx-3 d-none d-md-inline">|</span>
        <span class="d-none d-md-inline"><i class="bi bi-clock-fill text-success me-2"></i> Layanan Informasi Dokter & Jadwal Praktek</span>
      </div>
      <div>
        <% if (typeof user !== 'undefined' && user) { %>
          <!-- TAMPILAN JIKA USER SUDAH LOGIN -->
          <div class="d-flex align-items-center gap-2">
            <!-- Tombol Pintasan Portal Admin -->
            <% if (user.role === 'administrator' || user.role === 'admin' || user.role === 'finance' || user.role === 'kasir') { %>
              <a href="/dashboard" class="btn btn-sm btn-success px-2 py-0 fs-7 fw-semibold" title="Portal Admin">
                <i class="bi bi-speedometer2"></i> Portal Admin
              </a>
            <% } %>

            <span class="small text-light ms-2 me-1"><i class="bi bi-person-circle text-success me-1"></i> <%= user.nama || user.username %></span>
            <a href="/logout" class="btn btn-sm btn-outline-danger px-2 py-0 fs-7" title="Keluar">
              <i class="bi bi-box-arrow-right"></i> Logout
            </a>
          </div>
        <% } else { %>
          <!-- TOMBOL PEMICU MODAL LOGIN POP-UP JIKA BELUM LOGIN -->
          <button type="button" class="btn btn-sm btn-outline-neon fw-semibold px-3" data-bs-toggle="modal" data-bs-target="#loginModal">
            <i class="bi bi-box-arrow-in-right me-1"></i> Login Sistem
          </button>
        <% } %>
      </div>
    </div>
  </div>

  <!-- NAVBAR UTAMA -->
  <nav class="navbar navbar-expand-lg navbar-main sticky-top">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center" href="/">
        <img src="/image/logors.png" alt="Logo RS" height="42" class="me-3" onerror="this.style.display='none'">
        <div>
          <span class="fw-bold text-white fs-5 d-block">RS SAKTI MANDRA GUNA</span>
          <small class="text-muted" style="font-size: 0.65rem; letter-spacing: 1px;">BEDAH PLASTIK & KECANTIKAN</small>
        </div>
      </a>
      <button class="navbar-toggler navbar-dark" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item"><a class="nav-link" href="/">Beranda</a></li>
          <li class="nav-item"><a class="nav-link" href="/layanan">Layanan & Treatment</a></li>
          <li class="nav-item"><a class="nav-link active" href="/cek-dokter">Cari Dokter</a></li>
          <li class="nav-item"><a class="nav-link" href="/fasilitas">Fasilitas</a></li>
          <li class="nav-item ms-lg-3">
            <% if (typeof user !== 'undefined' && user) { %>
              <button type="button" class="btn btn-neon btn-sm px-3" data-bs-toggle="modal" data-bs-target="#modalBooking">
                <i class="bi bi-calendar-check me-1"></i> Buat Janji Temu
              </button>
            <% } else { %>
              <button type="button" class="btn btn-neon btn-sm px-3" data-bs-toggle="modal" data-bs-target="#loginModal">
                <i class="bi bi-calendar-check me-1"></i> Buat Janji Temu
              </button>
            <% } %>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- PAGE HEADER -->
  <div class="page-header text-center">
    <div class="container">
      <h2 class="section-title">Tim Dokter & Jadwal Praktek</h2>
      <p class="text-muted mt-3 mb-0">Temukan dokter spesialis terbaik dan cek jadwal konsultasi yang tersedia.</p>
    </div>
  </div>

  <!-- DAFTAR KOTAK DOKTER -->
  <section class="py-5">
    <div class="container">

      <!-- FILTER PENCARIAN -->
      <div class="row justify-content-center mb-5">
        <div class="col-md-6">
          <div class="input-group">
            <span class="input-group-text bg-dark text-white-50 border-secondary"><i class="bi bi-search"></i></span>
            <input type="text" id="searchDokter" class="form-control bg-dark text-white border-secondary" placeholder="Cari nama dokter, spesialisasi, atau deskripsi...">
          </div>
        </div>
      </div>

      <!-- GRID DOKTER -->
      <div class="row g-4" id="dokterGrid">
        <% if (typeof dokterList !== 'undefined' && dokterList && dokterList.length > 0) { %>
          <% dokterList.forEach(dokter => { %>
            <div class="col-md-4 dokter-card-item">
              <div class="doctor-card">
                <div>
                  <div class="d-flex align-items-center gap-3 mb-3">
                    <img src="<%= dokter.foto %>" alt="<%= dokter.nama_dokter %>" class="doctor-avatar" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3774/3774299.png'">
                    <div>
                      <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-2 py-1 mb-1">
                        <%= dokter.spesialis %>
                      </span>
                      <h5 class="fw-bold text-white mb-0 dokter-nama" style="font-size: 1.05rem;"><%= dokter.nama_dokter %></h5>
                    </div>
                  </div>

                  <!-- DESKRIPSI PERKENALAN DOKTER -->
                  <p class="text-muted small mb-3" style="font-size: 0.85rem; line-height: 1.5;">
                    <%= dokter.deskripsi %>
                  </p>

                  <!-- JADWAL PRAKTEK -->
                  <div class="schedule-box mb-3">
                    <div class="d-flex align-items-center text-warning fw-semibold mb-1">
                      <i class="bi bi-calendar-week me-2"></i> Jadwal Praktek
                    </div>
                    <p class="text-muted mb-0 small">
                      <%= dokter.jadwal_praktek %>
                    </p>
                  </div>
                </div>

                <div>
                  <% if (typeof user !== 'undefined' && user) { %>
                    <button type="button" class="btn btn-outline-neon btn-sm w-100 btn-pilih-dokter" data-dokter-id="<%= dokter.id %>" data-bs-toggle="modal" data-bs-target="#modalBooking">
                      <i class="bi bi-calendar-plus me-1"></i> Buat Janji dengan Dokter
                    </button>
                  <% } else { %>
                    <button type="button" class="btn btn-outline-neon btn-sm w-100" data-bs-toggle="modal" data-bs-target="#loginModal">
                      <i class="bi bi-box-arrow-in-right me-1"></i> Login untuk Booking
                    </button>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-12 text-center text-muted py-5">
            <i class="bi bi-person-x fs-1 d-block mb-3 text-secondary"></i>
            <p class="fs-5">Belum ada data dokter yang terdaftar saat ini.</p>
          </div>
        <% } %>
      </div>

    </div>
  </section>

  <!-- MODAL LOGIN POP-UP -->
  <div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content text-light" style="background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px;">
        <div class="modal-header border-bottom-0 pb-0">
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body px-4 pb-4">
          <div class="text-center mb-4">
            <img src="/image/logors.png" alt="Logo RS" height="50" class="mb-2" onerror="this.style.display='none'">
            <h5 class="fw-bold text-white mb-0">RS SAKTI MANDRA GUNA</h5>
            <small class="text-muted" style="font-size: 0.75rem; letter-spacing: 1px;">BEDAH PLASTIK & KECANTIKAN</small>
          </div>
          <div id="loginAlert" class="alert alert-danger text-center py-2 fs-6 mb-3 d-none"></div>
          <form id="formLoginPopup">
            <div class="mb-3">
              <label class="form-label text-light small fw-semibold">Username / Email</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-person"></i></span>
                <input type="text" id="popupUsername" name="username" class="form-control bg-dark border-secondary text-white" placeholder="Masukkan username" required>
              </div>
            </div>
            <div class="mb-4">
              <label class="form-label text-light small fw-semibold mb-0">Kata Sandi</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-lock"></i></span>
                <input type="password" id="popupPassword" name="password" class="form-control bg-dark border-secondary text-white" placeholder="Masukkan kata sandi" required>
              </div>
            </div>
            <button type="submit" class="btn btn-neon w-100 py-2 fw-semibold mb-3">
              Masuk <i class="bi bi-box-arrow-in-right ms-1"></i>
            </button>
            <div class="text-center pt-3 border-top border-secondary">
              <span class="small text-muted">Belum memiliki akun?</span>
              <a href="#" class="small fw-bold text-success text-decoration-none ms-1" data-bs-toggle="modal" data-bs-target="#registerModal" data-bs-dismiss="modal">Daftar Sekarang</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- INCLUDE ONLINE BOOKING MODAL (PARSIAL TERPUSAT) -->
  <%- include('onlinebooking') %>

  <!-- FOOTER -->
  <footer class="bg-dark text-white-50 pt-5 pb-3 border-top border-secondary">
    <div class="container text-center small">
      <p>&copy; 2026 RS Sakti Mandra Guna. All Rights Reserved.</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Live Search Dokter
    document.getElementById('searchDokter').addEventListener('input', function(e) {
      const keyword = e.target.value.toLowerCase();
      const items = document.querySelectorAll('.dokter-card-item');

      items.forEach(item => {
        const text = item.innerText.toLowerCase();
        if (text.includes(keyword)) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    });

    // Otomatis pilih dokter di modal booking ketika tombol diklik
    window.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.btn-pilih-dokter').forEach(btn => {
        btn.addEventListener('click', function() {
          const dokterId = this.getAttribute('data-dokter-id');
          const selectDokter = document.getElementById('selectDokter');
          if (selectDokter) {
            selectDokter.value = dokterId;
            selectDokter.dispatchEvent(new Event('change'));
          }
        });
      });
    });

    // Handling AJAX Login
    const formLoginPopup = document.getElementById('formLoginPopup');
    if (formLoginPopup) {
      formLoginPopup.addEventListener('submit', async function(e) {
        e.preventDefault();
        const username = document.getElementById('popupUsername').value;
        const password = document.getElementById('popupPassword').value;
        const alertBox = document.getElementById('loginAlert');
        alertBox.classList.add('d-none');

        try {
          const response = await fetch('/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password })
          });
          const result = await response.json();
          if (response.ok && result.success) {
            window.location.reload();
          } else {
            alertBox.innerText = result.message || 'Username atau password salah.';
            alertBox.classList.remove('d-none');
          }
        } catch (err) {
          alertBox.innerText = 'Terjadi kesalahan sistem server.';
          alertBox.classList.remove('d-none');
        }
      });
    }
  </script>
</body>
</html>