<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Riwayat Pasien - RS Sakti Mandra Guna</title>
 
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
 
  <!-- CSS Bootstrap 5 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  
  <style>
    :root {
      --bg-dark: #0d1117;
      --card-bg: #161b22;
      --sidebar-bg: #161b22;
      --border-color: #30363d;
      --accent-green: #2ea043;
      --accent-green-neon: #39FF14;
      --text-main: #c9d1d9;
      --text-heading: #ffffff;
      --text-sub: #8b949e;
    }

    body, html {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    .app-container {
      display: flex;
      min-height: 100vh;
    }

    /* SIDEBAR NAVIGASI */
    .sidebar {
      width: 250px;
      min-height: 100vh;
      background: var(--sidebar-bg);
      color: #ffffff;
      border-right: 1px solid var(--border-color);
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 20;
    }

    .sidebar-header {
      background: #010409;
      color: #ffffff;
      border-bottom: 1px solid var(--border-color);
      font-size: 0.85rem;
      padding: 16px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
      letter-spacing: 1px;
    }

    .logo-menu {
      height: 30px;
      width: auto;
    }

    .nav-section-title {
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: var(--accent-green-neon);
      padding: 14px 20px 4px;
    }

    .sidebar nav a {
      color: var(--text-sub);
      text-decoration: none;
      padding: 10px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 500;
      font-size: 0.875rem;
      transition: all 0.2s ease;
      border-left: 3px solid transparent;
    }

    .sidebar nav a:hover {
      background: rgba(255, 255, 255, 0.03);
      color: #ffffff;
    }

    .sidebar nav a.active {
      background: rgba(46, 160, 67, 0.15);
      color: var(--accent-green-neon);
      border-left-color: var(--accent-green-neon);
      font-weight: 600;
    }

    .sidebar-footer {
      padding: 14px 18px;
      font-size: 0.8rem;
      color: var(--text-sub);
      border-top: 1px solid var(--border-color);
      background: #010409;
    }

    /* MAIN CONTENT */
    .main-content {
      flex-grow: 1;
      position: relative;
      min-height: 100vh;
      background-color: var(--bg-dark);
    }

    .header-rs-center {
      background: var(--card-bg);
      padding: 18px 24px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
    }

    .logo-header {
      height: 48px;
      width: auto;
    }

    .header-title {
      color: var(--accent-green-neon);
      font-weight: 700;
      font-size: 1.35rem;
      margin: 0;
      letter-spacing: 0.5px;
    }

    .header-subtitle {
      color: var(--text-sub);
      font-size: 0.72rem;
      margin: 2px 0 0 0;
      letter-spacing: 1px;
    }

    .content-body {
      padding: 24px;
      position: relative;
    }

    /* WATERMARK LOGO DI BACKGROUND CONTENT */
    .watermark-bg {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 450px;
      max-width: 70%;
      opacity: 0.04;
      pointer-events: none;
      z-index: 0;
    }

    /* WIDGET CONTAINER */
    .widget-container {
      border: 1px solid var(--border-color);
      background-color: var(--card-bg);
      border-radius: 12px;
      overflow: hidden;
      height: 100%;
      position: relative;
      z-index: 1;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .widget-header {
      background-color: rgba(255, 255, 255, 0.02);
      color: var(--text-heading);
      padding: 14px 20px;
      font-weight: 600;
      font-size: 0.95rem;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* TABEL CUSTOM DARK */
    .table-dark-custom {
      --bs-table-bg: transparent !important;
      --bs-table-color: var(--text-main) !important;
      width: 100%;
      margin-bottom: 0;
      font-size: 0.875rem;
    }

    .table-dark-custom th {
      background-color: rgba(0, 0, 0, 0.25) !important;
      color: var(--accent-green-neon) !important;
      border-bottom: 1px solid var(--border-color) !important;
      padding: 12px 16px;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .table-dark-custom td {
      border-bottom: 1px solid var(--border-color) !important;
      padding: 12px 16px;
    }

    .btn-outline-neon {
      border: 1px solid var(--accent-green-neon);
      color: var(--accent-green-neon);
      background: transparent;
      font-size: 0.8rem;
      padding: 4px 10px;
      border-radius: 6px;
    }

    .btn-outline-neon:hover {
      background-color: var(--accent-green-neon);
      color: #000000;
    }
  </style>
</head>
<body>

  <div class="app-container">
    <!-- SIDEBAR NAVIGASI ADMINISTRATOR -->
    <div class="sidebar">
      <div>
        <div class="sidebar-header">
          <img src="/image/logors.png" alt="Logo RS" class="logo-menu" onerror="this.style.display='none'">
          <span>MENU UTAMA</span>
        </div>
        <nav>
          <a href="/"><i class="bi bi-house-door"></i> Beranda</a>
          <a href="/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
          <a href="/booking"><i class="bi bi-calendar-check"></i> Booking / Pemesanan</a>
          <a href="/finalisasi"><i class="bi bi-check2-square"></i> Finalisasi</a>
          <a href="/riwayat-transaksi"><i class="bi bi-clock-history"></i> Riwayat Transaksi</a>
          <a href="/riwayat-pasien" class="active"><i class="bi bi-person-lines-fill"></i> Riwayat Pasien</a>
          <a href="/tindakan"><i class="bi bi-hospital"></i> Layanan / Tindakan</a>
          <a href="/dokter"><i class="bi bi-person-badge"></i> Dokter</a>
          <a href="/suster"><i class="bi bi-heart-pulse"></i> Suster</a>
          <a href="/laporan"><i class="bi bi-file-earmark-bar-graph"></i> Laporan</a>
        </nav>
      </div>
      
      <!-- SIDEBAR FOOTER DENGAN DYNAMIC USER LOGIN & TOMBOL LOGOUT PRESISI DASHBOARD -->
      <div class="sidebar-footer d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-1 overflow-hidden me-2">
          <i class="bi bi-person-circle text-success me-1"></i>
          <strong class="text-white text-truncate" title="<%= typeof user !== 'undefined' && user ? (user.nama || user.username) : 'Administrator' %>">
            <%= typeof user !== 'undefined' && user ? (user.nama || user.username) : 'Administrator' %>
          </strong>
        </div>
        <a href="/logout" class="text-danger text-decoration-none" title="Keluar">
          <i class="bi bi-box-arrow-right fs-6"></i>
        </a>
      </div>
    </div>

    <!-- KONTEN UTAMA -->
    <div class="main-content">
      <!-- HEADER NAMA RUMAH SAKIT -->
      <div class="header-rs-center">
        <img src="/image/logors.png" alt="Logo RS" class="logo-header" onerror="this.style.display='none'">
        <div class="text-center">
          <h1 class="header-title">RS. SAKTI MANDRA GUNA</h1>
          <p class="header-subtitle">KHUSUS BEDAH PLASTIK, KECANTIKAN & TREATMENT</p>
        </div>
      </div>

      <div class="content-body">
        <!-- WATERMARK LOGO DI BACKGROUND CONTENT -->
        <img src="/image/logors.png" alt="Watermark RS" class="watermark-bg" onerror="this.style.display='none'">

        <!-- WIDGET CONTAINER RIWAYAT PASIEN -->
        <div class="widget-container">
          <div class="widget-header">
            <span><i class="bi bi-person-vcard text-info me-2"></i> Master Data & Database Riwayat Pasien</span>
            <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-50">
              Total: <%= (typeof pasiens !== 'undefined' && pasiens) ? pasiens.length : 0 %> Pasien
            </span>
          </div>

          <div class="table-responsive">
            <table class="table table-dark-custom align-middle">
              <thead>
                <tr>
                  <th class="text-center" style="width: 50px;">No</th>
                  <th>Nama Pasien</th>
                  <th>Alamat Domisili</th>
                  <th>Total Kunjungan</th>
                  <th>Kunjungan Terakhir</th>
                  <th>Total Transaksi</th>
                  <th class="text-center">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% if (typeof pasiens === 'undefined' || !pasiens || pasiens.length === 0) { %>
                  <tr>
                    <td colspan="7" class="text-center py-4 text-muted">Belum ada riwayat data pasien.</td>
                  </tr>
                <% } else { %>
                  <% pasiens.forEach((p, index) => { %>
                    <tr>
                      <td class="text-center"><%= index + 1 %></td>
                      <td><strong class="text-white"><%= p.nama_pasien %></strong></td>
                      <td><%= p.alamat_pasien || '-' %></td>
                      <td><span class="badge bg-secondary"><%= p.total_kunjungan %>x Tindakan</span></td>
                      <td><%= new Date(p.kunjungan_terakhir).toLocaleDateString('id-ID') %></td>
                      <td class="fw-bold text-success font-monospace">Rp <%= Number(p.total_pengeluaran).toLocaleString('id-ID') %></td>
                      <td class="text-center">
                        <a href="/riwayat-pasien/detail?nama=<%= encodeURIComponent(p.nama_pasien) %>" class="btn btn-sm btn-outline-neon">
                          <i class="bi bi-journal-medical me-1"></i> Histori Medis
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Bootstrap Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>