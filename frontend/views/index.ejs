<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RS Sakti Mandra Guna - Bedah Plastik & Kecantikan</title>
 
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
 
  <!-- Bootstrap 5 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
 
  <style>
    :root {
      --primary-color: #0d1117;
      --card-bg: #161b22;
      --border-color: #30363d;
      --accent-green: #2ea043;
      --accent-neon: #39FF14;
      --text-main: #e6edf3;
      --text-sub: #9198a1;
    }
 
    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--primary-color);
      color: var(--text-main);
    }
 
    .text-muted {
      color: var(--text-sub) !important;
    }
 
    /* TOP BAR */
    .top-bar {
      background-color: #010409;
      font-size: 0.8rem;
      border-bottom: 1px solid var(--border-color);
    }
 
    /* NAVBAR */
    .navbar-main {
      background-color: var(--card-bg);
      border-bottom: 1px solid var(--border-color);
    }
 
    .nav-link {
      color: #ffffff !important;
      font-weight: 500;
      padding: 8px 16px !important;
    }
 
    .nav-link:hover {
      color: var(--accent-neon) !important;
    }
 
    @media (min-width: 992px) {
      .nav-item.dropdown:hover .dropdown-menu {
        display: block;
        margin-top: 0;
        animation: fadeIn 0.2s ease-in-out;
      }
    }
 
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
 
    .custom-dropdown-menu {
      background-color: var(--card-bg);
      border: 1px solid var(--border-color);
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      border-radius: 8px;
      padding: 8px 0;
    }
 
    .custom-dropdown-item {
      color: var(--text-main);
      padding: 10px 20px;
      font-weight: 500;
      font-size: 0.9rem;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 10px;
    }
 
    .custom-dropdown-item:hover {
      background-color: rgba(46, 160, 67, 0.15);
      color: var(--accent-neon);
      padding-left: 24px;
    }
 
    /* HERO SLIDER */
    .hero-section {
      position: relative;
    }
 
    .carousel-item {
      height: 480px;
      background-size: cover;
      background-position: center;
    }
 
    .carousel-overlay {
      background: linear-gradient(180deg, rgba(13,17,23,0.3) 0%, rgba(13,17,23,0.9) 100%);
      height: 100%;
      display: flex;
      align-items: center;
    }
 
    /* FLOATING QUICK ACCESS */
    .quick-access-box {
      margin-top: -50px;
      position: relative;
      z-index: 10;
    }
 
    .quick-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      transition: transform 0.3s ease, border-color 0.3s ease;
      cursor: pointer;
    }
 
    .quick-card:hover {
      transform: translateY(-5px);
      border-color: var(--accent-green);
    }
 
    .section-title {
      color: #ffffff;
      font-weight: 700;
      position: relative;
      display: inline-block;
    }
 
    .section-title::after {
      content: '';
      position: absolute;
      width: 50%;
      height: 3px;
      background: var(--accent-neon);
      bottom: -8px;
      left: 0;
    }
 
    .service-card {
      background-color: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      overflow: hidden;
    }
 
    .service-desc {
      color: #d0d7de !important;
      font-size: 0.9rem;
      line-height: 1.6;
    }
 
    .btn-neon {
      background-color: var(--accent-green);
      color: #ffffff;
      font-weight: 600;
      border: none;
    }
 
    .btn-neon:hover {
      background-color: #2c974b;
      color: #ffffff;
    }
 
    .btn-outline-neon {
      border: 1px solid var(--accent-green);
      color: var(--accent-neon);
    }
 
    .btn-outline-neon:hover {
      background-color: var(--accent-green);
      color: #ffffff;
    }
  </style>
</head>
<body>
 
  <!-- TOP BAR -->
  <div class="top-bar py-2 text-white-50">
    <div class="container d-flex justify-content-between align-items-center">
      <div>
        <i class="bi bi-telephone-fill text-success me-2"></i> Emergency Call: <strong>(021) 555-9999</strong>
        <span class="mx-3 d-none d-md-inline">|</span>
        <span class="d-none d-md-inline"><i class="bi bi-clock-fill text-success me-2"></i> 24 Jam Pelayanan Darurat & Konsultasi</span>
      </div>
      <div>
        <% if (typeof user !== 'undefined' && user) { %>
          <!-- TAMPILAN JIKA USER SUDAH LOGIN -->
          <div class="d-flex align-items-center gap-2">
            <span class="small text-light me-2"><i class="bi bi-person-circle text-success me-1"></i> <%= user.nama || user.username %></span>
            <a href="/logout" class="btn btn-sm btn-outline-danger px-2 py-0 fs-7" title="Keluar">
              <i class="bi bi-box-arrow-right"></i> Logout
            </a>
          </div>
        <% } else { %>
          <!-- TOMBOL PEMICU MODAL LOGIN POP-UP JIKA BELUM LOGIN -->
          <button type="button" class="btn btn-sm btn-outline-neon fw-semibold px-3" data-bs-toggle="modal" data-bs-target="#loginModal">
            <i class="bi bi-box-arrow-in-right me-1"></i> Login Sistem
          </button>
        <% } %>
      </div>
    </div>
  </div>
 
  <!-- NAVBAR UTAMA -->
  <nav class="navbar navbar-expand-lg navbar-main sticky-top">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center" href="/">
        <img src="/image/logors.png" alt="Logo RS" height="42" class="me-3" onerror="this.style.display='none'">
        <div>
          <span class="fw-bold text-white fs-5 d-block">RS SAKTI MANDRA GUNA</span>
          <small class="text-muted" style="font-size: 0.65rem; letter-spacing: 1px;">BEDAH PLASTIK & KECANTIKAN</small>
        </div>
      </a>
      <button class="navbar-toggler navbar-dark" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item"><a class="nav-link" href="/">Beranda</a></li>
         
          <!-- LAYANAN DROPDOWN HOVER -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="/layanan" id="navbarLayanan" role="button" aria-expanded="false">
              Layanan
            </a>
            <ul class="dropdown-menu custom-dropdown-menu" aria-labelledby="navbarLayanan">
              <li>
                <a class="dropdown-item custom-dropdown-item" href="/layanan/bedah">
                  <i class="bi bi-scissors text-success"></i> Bedah
                </a>
              </li>
              <li>
                <a class="dropdown-item custom-dropdown-item" href="/layanan/treatment">
                  <i class="bi bi-stars text-success"></i> Treatment
                </a>
              </li>
              <li>
                <a class="dropdown-item custom-dropdown-item" href="/layanan/konsultasi">
                  <i class="bi bi-chat-heart text-success"></i> Konsultasi / Kontrol
                </a>
              </li>
            </ul>
          </li>
 
          <li class="nav-item"><a class="nav-link" href="/cek-dokter">Cek Dokter</a></li>
          <li class="nav-item"><a class="nav-link" href="/fasilitas">Fasilitas</a></li>
          <li class="nav-item ms-lg-3">
            <% if (typeof user !== 'undefined' && user) { %>
              <button type="button" class="btn btn-neon btn-sm px-3" data-bs-toggle="modal" data-bs-target="#modalBooking">
                <i class="bi bi-calendar-check me-1"></i> Buat Janji Temu
              </button>
            <% } else { %>
              <button type="button" class="btn btn-neon btn-sm px-3" data-bs-toggle="modal" data-bs-target="#loginModal">
                <i class="bi bi-calendar-check me-1"></i> Buat Janji Temu
              </button>
            <% } %>
          </li>
        </ul>
      </div>
    </div>
  </nav>
 
  <!-- HERO CAROUSEL / BANNER -->
  <div id="heroCarousel" class="carousel slide hero-section" data-bs-ride="carousel">
    <div class="carousel-inner">
      <div class="carousel-item active" style="background-image: url('https://images.unsplash.com/photo-1629909613654-28e377c37b09?q=80&w=1600');">
        <div class="carousel-overlay">
          <div class="container">
            <div class="col-lg-7">
              <span class="badge bg-success mb-2 px-3 py-2">Pusat Bedah Plastik & Aesthetic Utama</span>
              <h1 class="display-4 fw-bold text-white mb-3">Layanan Spesialis Bedah Rekonstruksi & Estetika</h1>
              <p class="lead text-light mb-4">Didukung oleh tim dokter berpengalaman dan teknologi medis terkini untuk memberikan perawatan aman dan presisi tinggi.</p>
             
              <!-- LOGIKA DINAMIS TOMBOL JANJI KONSULTASI -->
              <% if (typeof user !== 'undefined' && user) { %>
                <button type="button" class="btn btn-neon btn-lg px-4" data-bs-toggle="modal" data-bs-target="#modalBooking">
                  <i class="bi bi-calendar-check me-1"></i> Janji Konsultasi
                </button>
              <% } else { %>
                <button type="button" class="btn btn-neon btn-lg px-4" data-bs-toggle="modal" data-bs-target="#loginModal">
                  <i class="bi bi-box-arrow-in-right me-1"></i> Janji Konsultasi
                </button>
              <% } %>

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
 
  <!-- FLOATING QUICK ACCESS -->
  <div class="container quick-access-box">
    <div class="row g-3">
      <div class="col-md-3">
        <a href="/cek-dokter" class="text-decoration-none">
          <div class="quick-card p-4 text-center">
            <i class="bi bi-person-badge fs-1 text-success mb-2"></i>
            <h6 class="fw-bold text-white mb-1">Cek Dokter</h6>
            <small class="text-muted">Jadwal & Spesialisasi</small>
          </div>
        </a>
      </div>
 
      <div class="col-md-3">
        <% if (typeof user !== 'undefined' && user) { %>
          <div class="quick-card p-4 text-center" data-bs-toggle="modal" data-bs-target="#modalBooking">
            <i class="bi bi-calendar-plus fs-1 text-success mb-2"></i>
            <h6 class="fw-bold text-white mb-1">Buat Janji Temu</h6>
            <small class="text-muted">Booking Online Cepat</small>
          </div>
        <% } else { %>
          <div class="quick-card p-4 text-center" data-bs-toggle="modal" data-bs-target="#loginModal">
            <i class="bi bi-calendar-plus fs-1 text-success mb-2"></i>
            <h6 class="fw-bold text-white mb-1">Buat Janji Temu</h6>
            <small class="text-muted">Booking Online Cepat</small>
          </div>
        <% } %>
      </div>
 
      <div class="col-md-3">
        <a href="/layanan" class="text-decoration-none">
          <div class="quick-card p-4 text-center">
            <i class="bi bi-hospital fs-1 text-success mb-2"></i>
            <h6 class="fw-bold text-white mb-1">Daftar Tindakan</h6>
            <small class="text-muted">Estimasi Tarif & Prosedur</small>
          </div>
        </a>
      </div>
 
      <div class="col-md-3">
        <a href="/riwayat-pasien" class="text-decoration-none">
          <div class="quick-card p-4 text-center">
            <i class="bi bi-file-earmark-medical fs-1 text-success mb-2"></i>
            <h6 class="fw-bold text-white mb-1">Riwayat Pasien</h6>
            <small class="text-muted">Cek Rekam Medis / Invoice</small>
          </div>
        </a>
      </div>
    </div>
  </div>
 
  <!-- SEKSI LAYANAN UNGGULAN -->
  <section class="py-5 my-5">
    <div class="container">
      <div class="mb-5 text-center">
        <h2 class="section-title">Layanan & Center of Excellence</h2>
        <p class="text-muted mt-3 fs-6">Perawatan medis eksklusif yang dirancang khusus sesuai kebutuhan kesehatan dan estetika Anda.</p>
      </div>
 
      <div class="row g-4">
        <div class="col-md-4">
          <div class="service-card p-4 h-100">
            <i class="bi bi-scissors fs-1 text-success mb-3"></i>
            <h5 class="fw-bold text-white mb-2">Bedah (Surgical)</h5>
            <p class="service-desc">
              Prosedur rekonstruksi dan estetika seperti Rhinoplasty, Facelift, Liposuction, dan Blepharoplasty dengan standar medis internasional.
            </p>
          </div>
        </div>
 
        <div class="col-md-4">
          <div class="service-card p-4 h-100">
            <i class="bi bi-stars fs-1 text-success mb-3"></i>
            <h5 class="fw-bold text-white mb-2">Treatment (Non-Surgical)</h5>
            <p class="service-desc">
              Perawatan Laser Skin Rejuvenation, Botox, Filler, Skin Booster, dan Thread Lift tanpa pembedahan untuk hasil instan dan aman.
            </p>
          </div>
        </div>
 
        <div class="col-md-4">
          <div class="service-card p-4 h-100">
            <i class="bi bi-chat-heart fs-1 text-success mb-3"></i>
            <h5 class="fw-bold text-white mb-2">Konsultasi / Kontrol</h5>
            <p class="service-desc">
              Layanan konsultasi pra-tindakan dengan Dokter Spesialis Bedah Plastik serta pendampingan kontrol paska bedah intensif.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
 
  <!-- MODAL LOGIN POP-UP -->
  <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content text-light" style="background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px;">
       
        <div class="modal-header border-bottom-0 pb-0">
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
 
        <div class="modal-body px-4 pb-4">
          <!-- Logo & Judul -->
          <div class="text-center mb-4">
            <img src="/image/logors.png" alt="Logo RS" height="50" class="mb-2" onerror="this.style.display='none'">
            <h5 class="fw-bold text-white mb-0">RS SAKTI MANDRA GUNA</h5>
            <small class="text-muted" style="font-size: 0.75rem; letter-spacing: 1px;">BEDAH PLASTIK & KECANTIKAN</small>
          </div>
 
          <!-- Alert Error Pop-up Login -->
          <div id="loginAlert" class="alert alert-danger text-center py-2 fs-6 mb-3 d-none"></div>
 
          <!-- Form Login -->
          <form id="formLoginPopup">
            <div class="mb-3">
              <label class="form-label text-light small fw-semibold">Username / Email</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-person"></i></span>
                <input type="text" id="popupUsername" name="username" class="form-control bg-dark border-secondary text-white" placeholder="Masukkan username" required>
              </div>
            </div>
 
            <div class="mb-4">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label text-light small fw-semibold mb-0">Kata Sandi</label>
              </div>
              <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-lock"></i></span>
                <input type="password" id="popupPassword" name="password" class="form-control bg-dark border-secondary text-white" placeholder="Masukkan kata sandi" required>
              </div>
            </div>
 
            <button type="submit" class="btn btn-neon w-100 py-2 fw-semibold mb-3">
              Masuk <i class="bi bi-box-arrow-in-right ms-1"></i>
            </button>
 
            <!-- TAUTAN AJAKAN DAFTAR (Pemicu Modal Register) -->
            <div class="text-center pt-3 border-top border-secondary">
              <span class="small text-muted">Belum memiliki akun?</span>
              <a href="#" class="small fw-bold text-success text-decoration-none ms-1" data-bs-toggle="modal" data-bs-target="#registerModal" data-bs-dismiss="modal">Daftar Sekarang</a>
            </div>
          </form>
        </div>
 
      </div>
    </div>
  </div>
  
  <!-- MODAL REGISTER POP-UP (PENDAFTARAN AKUN PASIEN) -->
  <div class="modal fade" id="registerModal" tabindex="-1" aria-labelledby="registerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content text-light" style="background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px;">
       
        <div class="modal-header border-bottom-0 pb-0">
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
  
        <div class="modal-body px-4 pb-4">
          <!-- Logo & Judul -->
          <div class="text-center mb-4">
            <img src="/image/logors.png" alt="Logo RS" height="50" class="mb-2" onerror="this.style.display='none'">
            <h5 class="fw-bold text-white mb-0">PENDAFTARAN AKUN PASIEN</h5>
            <small class="text-muted" style="font-size: 0.75rem; letter-spacing: 1px;">RS SAKTI MANDRA GUNA</small>
          </div>
  
          <!-- Alert Pop-up Register -->
          <div id="registerAlert" class="alert text-center py-2 fs-6 mb-3 d-none"></div>
  
          <!-- Form Register -->
          <form id="formRegisterPopup" action="/register" method="POST">
            <div class="mb-3">
              <label class="form-label text-light small fw-semibold">Nama Lengkap Pasien</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-person"></i></span>
                <input type="text" id="regNama" name="nama" class="form-control bg-dark border-secondary text-white" placeholder="Masukkan nama lengkap" required>
              </div>
            </div>
  
            <div class="mb-3">
              <label class="form-label text-light small fw-semibold">Username / Email</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-at"></i></span>
                <input type="text" id="regUsername" name="username" class="form-control bg-dark border-secondary text-white" placeholder="Masukkan username atau email" required>
              </div>
            </div>
  
            <div class="mb-3">
              <label class="form-label text-light small fw-semibold">Kata Sandi (Password)</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-lock"></i></span>
                <input type="password" id="regPassword" name="password" class="form-control bg-dark border-secondary text-white" placeholder="Buat kata sandi baru" required>
              </div>
            </div>
  
            <div class="mb-4">
              <label class="form-label text-light small fw-semibold">Nomor HP / WhatsApp</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-whatsapp"></i></span>
                <input type="tel" id="regNoHp" name="no_hp" class="form-control bg-dark border-secondary text-white" placeholder="08xxxxxxxxxx" required>
              </div>
            </div>
  
            <button type="submit" class="btn btn-neon w-100 py-2 fw-semibold mb-3">
              Daftar Akun Baru <i class="bi bi-person-plus ms-1"></i>
            </button>

            <!-- TAUTAN KEMBALI KE LOGIN -->
            <div class="text-center pt-3 border-top border-secondary">
              <span class="small text-muted">Sudah memiliki akun?</span>
              <a href="#" class="small fw-bold text-success text-decoration-none ms-1" data-bs-toggle="modal" data-bs-target="#loginModal" data-bs-dismiss="modal">Masuk / Login</a>
            </div>
          </form>
        </div>
  
      </div>
    </div>
  </div>
 
  <!-- POP-UP MODAL BOOKING ONLINE (JIKA USER SUDAH LOGIN) -->
  <div class="modal fade" id="modalBooking" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content text-light" style="background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px;">
        <div class="modal-header border-secondary">
          <h5 class="modal-title fs-6 fw-bold text-white"><i class="bi bi-calendar-plus-fill text-success me-2"></i>Buat Janji Konsultasi Online</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/booking/simpan" method="POST">
          <div class="modal-body">
            <div class="row g-3">
              
              <!-- Nama Pasien -->
              <div class="col-md-6">
                <label class="form-label small text-muted">Nama Lengkap Pasien</label>
                <input type="text" name="nama_pasien" class="form-control bg-dark text-white border-secondary" value="<%= typeof user !== 'undefined' && user ? (user.nama || user.username) : '' %>" placeholder="Masukkan nama lengkap" required>
              </div>

              <!-- Nomor KTP (NIK) -->
              <div class="col-md-6">
                <label class="form-label small text-muted">Nomor KTP (NIK)</label>
                <input type="text" name="no_ktp" class="form-control bg-dark text-white border-secondary" maxlength="16" placeholder="Masukkan 16 digit NIK" required>
              </div>

              <!-- Nomor HP / WhatsApp -->
              <div class="col-md-6">
                <label class="form-label small text-muted">Nomor HP / WhatsApp</label>
                <input type="tel" name="no_hp" class="form-control bg-dark text-white border-secondary" value="<%= typeof user !== 'undefined' && user ? (user.no_hp || '') : '' %>" placeholder="08xxxxxxxxxx" required>
              </div>

              <!-- Tanggal Konsultasi -->
              <div class="col-md-6">
                <label class="form-label small text-muted">Tanggal Rencana Konsultasi/Tindakan</label>
                <input type="date" name="tanggal_tindakan" class="form-control bg-dark text-white border-secondary" required>
              </div>

              <!-- Pilih Dokter -->
              <div class="col-md-6">
                <label class="form-label small text-muted">Pilih Dokter Spesialis</label>
                <select name="dokter_id" class="form-select bg-dark text-white border-secondary" required>
                  <option value="">-- Pilih Dokter --</option>
                  <% if (typeof dokters !== 'undefined' && dokters.length > 0) { %>
                    <% dokters.forEach(d => { %>
                      <option value="<%= d.id %>"><%= d.nama %> (<%= d.spesialis %>)</option>
                    <% }); %>
                  <% } else { %>
