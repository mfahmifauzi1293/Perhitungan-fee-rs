<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Laporan Rekapitulasi - RS Sakti Mandra Guna</title>
 
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
 
  <!-- CSS Bootstrap 5 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
 
  <style>
    :root {
      --bg-dark: #0d1117;
      --card-bg: #161b22;
      --sidebar-bg: #161b22;
      --border-color: #30363d;
      --accent-green: #2ea043;
      --accent-green-neon: #39FF14;
      --text-main: #c9d1d9;
      --text-heading: #ffffff;
      --text-sub: #8b949e;
    }

    body, html {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    /* VISIBILITAS TEKS INPUT TANGGAL DI DARK MODE */
    input[type="date"].custom-date-input {
      color-scheme: dark !important;
      color: #ffffff !important;
      background-color: #161b22 !important;
      border: 1px solid #30363d !important;
      font-weight: 600 !important;
    }

    input[type="date"].custom-date-input::-webkit-calendar-picker-indicator {
      filter: invert(1) brightness(1.5) !important;
      cursor: pointer;
    }

    .app-container {
      display: flex;
      min-height: 100vh;
    }

    /* SIDEBAR NAVIGASI */
    .sidebar {
      width: 250px;
      min-height: 100vh;
      background: var(--sidebar-bg);
      color: #ffffff;
      border-right: 1px solid var(--border-color);
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 20;
    }

    .sidebar-header {
      background: #010409;
      color: #ffffff;
      border-bottom: 1px solid var(--border-color);
      font-size: 0.85rem;
      padding: 16px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
      letter-spacing: 1px;
    }

    .logo-menu {
      height: 30px;
      width: auto;
    }

    .sidebar nav a {
      color: var(--text-sub);
      text-decoration: none;
      padding: 10px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 500;
      font-size: 0.875rem;
      transition: all 0.2s ease;
      border-left: 3px solid transparent;
    }

    .sidebar nav a:hover {
      background: rgba(255, 255, 255, 0.03);
      color: #ffffff;
    }

    .sidebar nav a.active {
      background: rgba(46, 160, 67, 0.15);
      color: var(--accent-green-neon);
      border-left-color: var(--accent-green-neon);
      font-weight: 600;
    }

    .sidebar-footer {
      padding: 14px 18px;
      font-size: 0.8rem;
      color: var(--text-sub);
      border-top: 1px solid var(--border-color);
      background: #010409;
    }

    /* MAIN CONTENT */
    .main-content {
      flex-grow: 1;
      position: relative;
      min-height: 100vh;
      background-color: var(--bg-dark);
    }

    .header-rs-center {
      background: var(--card-bg);
      padding: 18px 24px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
    }

    .logo-header {
      height: 48px;
      width: auto;
    }

    .header-title {
      color: var(--accent-green-neon);
      font-weight: 700;
      font-size: 1.35rem;
      margin: 0;
      letter-spacing: 0.5px;
    }

    .header-subtitle {
      color: var(--text-sub);
      font-size: 0.72rem;
      margin: 2px 0 0 0;
      letter-spacing: 1px;
    }

    .content-body {
      padding: 24px;
      position: relative;
    }

    .watermark-bg {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 450px;
      max-width: 70%;
      opacity: 0.04;
      pointer-events: none;
      z-index: 0;
    }

    .widget-container {
      border: 1px solid var(--border-color);
      background-color: var(--card-bg);
      border-radius: 12px;
      overflow: hidden;
      height: 100%;
      position: relative;
      z-index: 1;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .widget-header {
      background-color: rgba(255, 255, 255, 0.02);
      color: var(--text-heading);
      padding: 14px 20px;
      font-weight: 600;
      font-size: 0.95rem;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .table-dark-custom {
      --bs-table-bg: transparent !important;
      --bs-table-color: var(--text-main) !important;
      width: 100%;
      margin-bottom: 0;
      font-size: 0.875rem;
    }

    .table-dark-custom th {
      background-color: rgba(0, 0, 0, 0.25) !important;
      color: var(--accent-green-neon) !important;
      border-bottom: 1px solid var(--border-color) !important;
      padding: 12px 16px;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .table-dark-custom td {
      border-bottom: 1px solid var(--border-color) !important;
      padding: 12px 16px;
    }

    .table-hover-custom tbody tr:hover {
      background-color: rgba(46, 160, 67, 0.08) !important;
    }

    .btn-tab-active {
      background-color: var(--accent-green) !important;
      color: #ffffff !important;
      border-color: var(--accent-green) !important;
    }

    .btn-tab-inactive {
      background-color: transparent !important;
      color: var(--text-main) !important;
      border: 1px solid var(--border-color) !important;
    }

    .btn-tab-inactive:hover {
      background-color: rgba(255, 255, 255, 0.05) !important;
      color: #ffffff !important;
    }
  </style>
</head>
<body>

  <div class="app-container">
    <!-- SIDEBAR NAVIGASI -->
    <div class="sidebar">
      <div>
        <div class="sidebar-header">
          <img src="/image/logors.png" alt="Logo RS" class="logo-menu" onerror="this.style.display='none'">
          <span>MENU UTAMA</span>
        </div>
        <nav>
          <a href="/"><i class="bi bi-house-door"></i> Beranda</a>
          <a href="/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
          <a href="/booking"><i class="bi bi-calendar-check"></i> Booking / Pemesanan</a>
          <a href="/finalisasi"><i class="bi bi-check2-square"></i> Finalisasi</a>
          <a href="/riwayat-transaksi"><i class="bi bi-clock-history"></i> Riwayat Transaksi</a>
          <a href="/riwayat-pasien"><i class="bi bi-person-lines-fill"></i> Riwayat Pasien</a>
          <a href="/tindakan"><i class="bi bi-hospital"></i> Layanan / Tindakan</a>
          <a href="/dokter"><i class="bi bi-person-badge"></i> Dokter</a>
          <a href="/suster"><i class="bi bi-heart-pulse"></i> Suster</a>
          <a href="/payroll"><i class="bi bi-cash-stack"></i> Payroll / Gaji</a>
          <a href="/lembur"><i class="bi bi-stopwatch"></i> Input Lembur</a>
          <a href="/laporan" class="active"><i class="bi bi-file-earmark-bar-graph"></i> Laporan</a>
        </nav>
      </div>
     
      <div class="sidebar-footer d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-1 overflow-hidden me-2">
          <i class="bi bi-person-circle text-success me-1"></i>
          <strong class="text-white text-truncate" title="<%= typeof user !== 'undefined' && user ? (user.nama || user.username) : 'Administrator' %>">
            <%= typeof user !== 'undefined' && user ? (user.nama || user.username) : 'Administrator' %>
          </strong>
        </div>
        <a href="/logout" class="text-danger text-decoration-none" title="Keluar">
          <i class="bi bi-box-arrow-right fs-6"></i>
        </a>
      </div>
    </div>

    <!-- KONTEN UTAMA -->
    <div class="main-content">
      <div class="header-rs-center">
        <img src="/image/logors.png" alt="Logo RS" class="logo-header" onerror="this.style.display='none'">
        <div class="text-center">
          <h1 class="header-title">RS. SAKTI MANDRA GUNA</h1>
          <p class="header-subtitle">KHUSUS BEDAH PLASTIK, KECANTIKAN & TREATMENT</p>
        </div>
      </div>

      <div class="content-body">
        <img src="/image/logors.png" alt="Watermark RS" class="watermark-bg" onerror="this.style.display='none'">

        <!-- TOGGLE SWITCH & FILTER RENTANG TANGGAL CUTOFF -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4" style="position: relative; z-index: 1;">
          <div class="btn-group">
            <a href="/laporan?jenis=dokter&tanggal_mulai=<%= typeof tanggalMulai !== 'undefined' ? tanggalMulai : '' %>&tanggal_selesai=<%= typeof tanggalSelesai !== 'undefined' ? tanggalSelesai : '' %>"
               class="btn btn-sm <%= (typeof jenis !== 'undefined' && jenis === 'dokter') ? 'btn-tab-active' : 'btn-tab-inactive' %> fw-bold px-3">
              <i class="bi bi-person-badge me-1"></i> Laporan Dokter (All Dokter)
            </a>
            <a href="/laporan?jenis=suster&tanggal_mulai=<%= typeof tanggalMulai !== 'undefined' ? tanggalMulai : '' %>&tanggal_selesai=<%= typeof tanggalSelesai !== 'undefined' ? tanggalSelesai : '' %>"
               class="btn btn-sm <%= (typeof jenis !== 'undefined' && jenis === 'suster') ? 'btn-tab-active' : 'btn-tab-inactive' %> fw-bold px-3">
              <i class="bi bi-heart-pulse me-1"></i> Laporan Suster (All Suster)
            </a>
          </div>

          <!-- FORM FILTER TANGGAL CUTOFF -->
          <form action="/laporan" method="GET" class="d-flex align-items-center gap-2 bg-dark p-2 rounded border border-secondary">
            <input type="hidden" name="jenis" value="<%= typeof jenis !== 'undefined' ? jenis : 'dokter' %>">
            <div class="d-flex align-items-center gap-1">
              <small class="text-light fw-bold">Dari:</small>
              <input type="date" name="tanggal_mulai" value="<%= typeof tanggalMulai !== 'undefined' ? tanggalMulai : '' %>" class="form-control form-control-sm custom-date-input">
            </div>
            <div class="d-flex align-items-center gap-1">
              <small class="text-light fw-bold">s/d:</small>
              <input type="date" name="tanggal_selesai" value="<%= typeof tanggalSelesai !== 'undefined' ? tanggalSelesai : '' %>" class="form-control form-control-sm custom-date-input">
            </div>
            <button type="submit" class="btn btn-sm btn-success fw-bold">
              <i class="bi bi-filter"></i> Filter
            </button>
          </form>
        </div>

        <!-- WIDGET REKAPITULASI -->
        <div class="widget-container">
          <div class="widget-header">
            <span>
              <i class="bi bi-bar-chart-line text-success me-2"></i>
              Daftar Rekap <%= (typeof jenis !== 'undefined' && jenis === 'dokter') ? 'Dokter' : 'Suster' %> — Periode: <%= (typeof tanggalMulai !== 'undefined' ? tanggalMulai : '') %> s/d <%= (typeof tanggalSelesai !== 'undefined' ? tanggalSelesai : '') %>
            </span>
            <span class="badge bg-secondary"><%= (typeof laporans !== 'undefined') ? laporans.length : 0 %> Record</span>
          </div>

          <div class="table-responsive">
            <table class="table table-dark-custom table-hover-custom align-middle">
              <thead>
                <tr>
                  <th class="text-center" style="width: 50px;">No</th>
                  <th>Nama <%= (typeof jenis !== 'undefined' && jenis === 'dokter') ? 'Dokter' : 'Suster' %></th>
                  <th>Fokus / Peran</th>
                  <th>Total Tindakan Completed</th>
                  <% if (typeof jenis !== 'undefined' && jenis === 'dokter') { %>
                    <th>Total Fee Diterima</th>
                  <% } else { %>
                    <th>Total Fee Diterima</th>
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% if (typeof laporans === 'undefined' || laporans.length === 0) { %>
                  <tr>
                    <td colspan="5" class="text-center py-4 text-muted">
                      Belum ada data rekapitulasi laporan untuk rentang tanggal ini.
                    </td>
                  </tr>
                <% } else { %>
                  <% laporans.forEach((l, idx) => { %>
                    <tr onclick="lihatRincian('<%= l.id %>', '<%= l.nama.replace(/'/g, "\\'") %>', '<%= jenis %>', '<%= tanggalMulai %>', '<%= tanggalSelesai %>')" style="cursor: pointer;" title="Klik untuk melihat rincian tindakan">
                      <td class="text-center"><%= idx + 1 %></td>
                      <td>
                        <strong class="text-white"><%= l.nama %></strong>
                        <i class="bi bi-box-arrow-up-right text-muted fs-7 ms-1"></i>
                      </td>
                      <td>
                        <span class="badge bg-secondary"><%= l.fokus || l.peran || '-' %></span>
                      </td>
                      <td><%= l.total_tindakan || 0 %> Kali</td>
                      <td class="fw-bold text-success font-monospace">
                        Rp <%= Number(l.total_fee || 0).toLocaleString('id-ID') %>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- MODAL RINCIAN TINDAKAN -->
  <div class="modal fade" id="modalRincian" tabindex="-1" aria-labelledby="modalRincianLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content" style="background-color: #161b22; border: 1px solid #30363d; color: #c9d1d9;">
        <div class="modal-header border-bottom border-secondary bg-black">
          <h5 class="modal-title fs-6 text-white fw-bold" id="modalRincianLabel">
            <i class="bi bi-journal-text text-success me-2"></i> Rincian Tindakan: <span id="namaPetugasModal" class="text-info"></span>
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="table-responsive">
            <table class="table table-dark-custom align-middle">
              <thead>
                <tr>
                  <th class="text-center" style="width: 50px;">No</th>
                  <th>Tgl Tindakan</th>
                  <th>Nama Pasien</th>
                  <th>Jenis Tindakan</th>
                  <th class="text-end">Fee Diterima</th>
                </tr>
              </thead>
              <tbody id="tabelRincianBody">
                <tr>
                  <td colspan="5" class="text-center py-3 text-muted">Memuat data...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <div class="modal-footer border-top border-secondary bg-black">
          <button type="button" class="btn btn-secondary btn-sm fw-bold" data-bs-dismiss="modal">Tutup</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- SCRIPT AJAX UNTUK MODAL RINCIAN -->
  <script>
    function lihatRincian(id, nama, jenis, mulai, selesai) {
      document.getElementById('namaPetugasModal').innerText = nama;
      const tbody = document.getElementById('tabelRincianBody');
      tbody.innerHTML = `<tr><td colspan="5" class="text-center py-3 text-muted">Memuat data...</td></tr>`;

      const myModal = new bootstrap.Modal(document.getElementById('modalRincian'));
      myModal.show();

      fetch(`/api/laporan/rincian?id=${id}&jenis=${jenis}&mulai=${mulai}&selesai=${selesai}`)
        .then(response => response.json())
        .then(data => {
          if (!data || data.length === 0) {
            tbody.innerHTML = `<tr><td colspan="5" class="text-center py-3 text-muted">Tidak ada rincian tindakan pada rentang tanggal ini.</td></tr>`;
            return;
          }

          let html = '';
          data.forEach((item, index) => {
            const tgl = item.tanggal_tindakan ? new Date(item.tanggal_tindakan).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '-';
            const fee = Math.round(Number(item.fee_diterima || 0)).toLocaleString('id-ID');
            html += `
              <tr>
                <td class="text-center">${index + 1}</td>
                <td>${tgl}</td>
                <td><strong class="text-white">${item.nama_pasien || '-'}</strong></td>
                <td><span class="badge bg-secondary text-light">${item.jenis_tindakan || '-'}</span></td>
                <td class="text-end fw-bold text-success font-monospace">Rp ${fee}</td>
              </tr>
            `;
          });
          tbody.innerHTML = html;
        })
        .catch(err => {
          console.error(err);
          tbody.innerHTML = `<tr><td colspan="5" class="text-center py-3 text-danger">Gagal memuat data rincian.</td></tr>`;
        });
    }
  </script>
</body>
</html>