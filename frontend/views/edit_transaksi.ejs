<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Transaksi - <%= t.nama_pasien %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="/">🏥 Fee Splitter Medis</a>
    </div>
  </nav>

  <div class="container my-4" style="max-width: 900px;">
    <div class="card shadow-sm">
      <div class="card-header bg-warning text-dark fw-bold d-flex justify-content-between align-items-center">
        <span>✏️ Edit Transaksi (ID: TRX-<%= String(t.id).padStart(5, '0') %>)</span>
        <span class="badge <%= t.status_pembayaran === 'LUNAS' ? 'bg-success' : 'bg-secondary' %>">
          Status: <%= t.status_pembayaran %>
        </span>
      </div>
      <div class="card-body">
        <form action="/transaksi/update/<%= t.id %>" method="POST">
          
          <!-- BAGIAN 1: BOOKING & INFORMASI PASIEN -->
          <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">1. Informasi Pasien & Booking</h5>
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label">Nama Pasien</label>
              <input type="text" name="nama_pasien" class="form-control" value="<%= t.nama_pasien %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Tanggal Tindakan</label>
              <input type="date" name="tanggal_tindakan" class="form-control" value="<%= new Date(t.tanggal_tindakan).toISOString().split('T')[0] %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Dokter Operator Utama</label>
              <select name="dokter_id" class="form-select" required>
                <% dokters.forEach(d => { %>
                  <option value="<%= d.id %>" <%= t.dokter_id == d.id ? 'selected' : '' %>><%= d.nama %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Jenis Tindakan Medis</label>
              <input type="text" name="jenis_tindakan" class="form-control" value="<%= t.jenis_tindakan %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Harga Bruto (Rp)</label>
              <input type="number" name="total_harga" class="form-control" value="<%= t.total_harga %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Diskon (Rp)</label>
              <input type="number" name="diskon" class="form-control" value="<%= t.diskon %>">
            </div>
          </div>

          <!-- BAGIAN 2: RINCIAN TIM MEDIS (Hanya Aktif Jika Sudah COMPLETED) -->
          <% if (t.status_pembayaran === 'LUNAS') { %>
            <h5 class="fw-bold text-success border-bottom pb-2 mb-3">2. Tim Medis & Operational Costs</h5>
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label class="form-label">Dokter Anestesi</label>
                <select name="dokter_anestesi_id" class="form-select">
                  <option value="">-- Tanpa Anestesi --</option>
                  <% dokters.forEach(d => { %>
                    <option value="<%= d.id %>" <%= t.dokter_anestesi_id == d.id ? 'selected' : '' %>><%= d.nama %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Tipe Anestesi</label>
                <select name="tipe_anestesi" class="form-select">
                  <option value="LOKAL" <%= t.tipe_anestesi === 'LOKAL' ? 'selected' : '' %>>Lokal (Rp 0)</option>
                  <option value="SEDASI" <%= t.tipe_anestesi === 'SEDASI' ? 'selected' : '' %>>Sedasi (Rp 1.500.000)</option>
                  <option value="UMUM" <%= t.tipe_anestesi === 'UMUM' ? 'selected' : '' %>>Umum / GA (Rp 3.500.000)</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Durasi Operasi (Jam)</label>
                <input type="number" name="durasi_operasi_jam" class="form-control" value="<%= t.durasi_operasi_jam %>" min="1">
              </div>
              <div class="col-md-6">
                <label class="form-label">Suster Asisten 1</label>
                <select name="suster_op1_id" class="form-select">
                  <option value="">-- Tidak Ada --</option>
                  <% susters.forEach(s => { %>
                    <option value="<%= s.id %>" <%= t.suster_op1_id == s.id ? 'selected' : '' %>><%= s.nama %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Suster Asisten 2</label>
                <select name="suster_op2_id" class="form-select">
                  <option value="">-- Tidak Ada --</option>
                  <% susters.forEach(s => { %>
                    <option value="<%= s.id %>" <%= t.suster_op2_id == s.id ? 'selected' : '' %>><%= s.nama %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Suster Asisten 3</label>
                <select name="suster_op3_id" class="form-select">
                  <option value="">-- Tidak Ada --</option>
                  <% susters.forEach(s => { %>
                    <option value="<%= s.id %>" <%= t.suster_op3_id == s.id ? 'selected' : '' %>><%= s.nama %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Suster Rawat Inap</label>
                <select name="suster_rawat_id" class="form-select">
                  <option value="">-- Tidak Ada --</option>
                  <% susters.forEach(s => { %>
                    <option value="<%= s.id %>" <%= t.suster_rawat_id == s.id ? 'selected' : '' %>><%= s.nama %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Biaya Obat / Implant / Alkes (Rp)</label>
                <input type="number" name="biaya_obat" class="form-control" value="<%= t.biaya_obat %>">
              </div>
            </div>
          <% } %>

          <div class="d-flex justify-content-between">
            <a href="/" class="btn btn-secondary">Batal / Kembali</a>
            <button type="submit" class="btn btn-warning fw-bold">💾 Simpan Perubahan Data</button>
          </div>
        </form>
      </div>
    </div>
  </div>

</body>
</html>