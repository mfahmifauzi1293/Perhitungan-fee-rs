<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Master Suster - RS Sakti Mandra Guna</title>
 
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
 
  <!-- CSS Bootstrap 5 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
 
  <style>
    :root {
      --bg-dark: #0d1117;
      --card-bg: #161b22;
      --sidebar-bg: #161b22;
      --border-color: #30363d;
      --accent-green: #2ea043;
      --accent-green-neon: #39FF14;
      --text-main: #c9d1d9;
      --text-heading: #ffffff;
      --text-sub: #8b949e;
      --input-bg: #0d1117;
    }

    body, html {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    .app-container {
      display: flex;
      min-height: 100vh;
    }

    /* SIDEBAR NAVIGASI */
    .sidebar {
      width: 250px;
      min-height: 100vh;
      background: var(--sidebar-bg);
      color: #ffffff;
      border-right: 1px solid var(--border-color);
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 20;
    }

    .sidebar-header {
      background: #010409;
      color: #ffffff;
      border-bottom: 1px solid var(--border-color);
      font-size: 0.85rem;
      padding: 16px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
      letter-spacing: 1px;
    }

    .logo-menu {
      height: 30px;
      width: auto;
    }

    .sidebar nav a {
      color: var(--text-sub);
      text-decoration: none;
      padding: 10px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 500;
      font-size: 0.875rem;
      transition: all 0.2s ease;
      border-left: 3px solid transparent;
    }

    .sidebar nav a:hover {
      background: rgba(255, 255, 255, 0.03);
      color: #ffffff;
    }

    .sidebar nav a.active {
      background: rgba(46, 160, 67, 0.15);
      color: var(--accent-green-neon);
      border-left-color: var(--accent-green-neon);
      font-weight: 600;
    }

    .sidebar-footer {
      padding: 14px 18px;
      font-size: 0.8rem;
      color: var(--text-sub);
      border-top: 1px solid var(--border-color);
      background: #010409;
    }

    /* MAIN CONTENT */
    .main-content {
      flex-grow: 1;
      position: relative;
      min-height: 100vh;
      background-color: var(--bg-dark);
    }

    .header-rs-center {
      background: var(--card-bg);
      padding: 18px 24px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
    }

    .logo-header {
      height: 48px;
      width: auto;
    }

    .header-title {
      color: var(--accent-green-neon);
      font-weight: 700;
      font-size: 1.35rem;
      margin: 0;
      letter-spacing: 0.5px;
    }

    .header-subtitle {
      color: var(--text-sub);
      font-size: 0.72rem;
      margin: 2px 0 0 0;
      letter-spacing: 1px;
    }

    .content-body {
      padding: 24px;
      position: relative;
    }

    .watermark-bg {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 450px;
      max-width: 70%;
      opacity: 0.04;
      pointer-events: none;
      z-index: 0;
    }

    .widget-container {
      border: 1px solid var(--border-color);
      background-color: var(--card-bg);
      border-radius: 12px;
      overflow: hidden;
      position: relative;
      z-index: 1;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .modal-label-custom {
      color: var(--accent-green-neon) !important;
      font-weight: 600;
      font-size: 0.85rem;
      margin-bottom: 4px;
      display: block;
    }

    .form-control-dark, .form-select-dark {
      background-color: var(--input-bg) !important;
      border: 1px solid var(--border-color) !important;
      color: #ffffff !important;
      font-size: 0.875rem;
    }

    .form-control-dark:focus, .form-select-dark:focus {
      background-color: var(--input-bg) !important;
      border-color: var(--accent-green-neon) !important;
      color: #ffffff !important;
      box-shadow: 0 0 0 0.2rem rgba(57, 255, 20, 0.2);
    }

    .btn-green-neon {
      background-color: var(--accent-green);
      color: #ffffff;
      border: none;
      font-size: 0.8rem;
      font-weight: 600;
      padding: 6px 14px;
      border-radius: 6px;
    }

    .btn-green-neon:hover {
      background-color: #2c974b;
      color: #ffffff;
    }

    .modal-content-dark {
      background-color: #161b22;
      color: #ffffff !important;
      border: 1px solid var(--border-color);
      border-radius: 12px;
    }

    /* SUSTER CARD CLEAN LAYOUT */
    .suster-card {
      background-color: #0d1117;
      border: 1px solid var(--border-color);
      border-radius: 10px;
      transition: all 0.2s ease;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
    }

    .suster-card:hover {
      border-color: var(--accent-green);
      box-shadow: 0 4px 15px rgba(46, 160, 67, 0.15);
    }

    .card-title-neon {
      color: var(--accent-green-neon);
      font-weight: 700;
      font-size: 1rem;
    }

    .suster-avatar-lg {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--accent-green);
      background-color: #161b22;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-sub);
      font-size: 1.8rem;
      flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    /* AREA TOMBOL AKSI DENGAN PEMISAH SENDIRI */
    .card-footer-action {
      background-color: rgba(255, 255, 255, 0.01);
      border-top: 1px solid var(--border-color);
      padding: 10px 16px;
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }
  </style>
</head>
<body>

  <div class="app-container">
    <!-- SIDEBAR NAVIGASI ADMINISTRATOR -->
    <div class="sidebar">
      <div>
        <div class="sidebar-header">
          <img src="/image/logors.png" alt="Logo RS" class="logo-menu" onerror="this.style.display='none'">
          <span>MENU UTAMA</span>
        </div>
        <nav>
          <a href="/"><i class="bi bi-house-door"></i> Beranda</a>
          <a href="/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
          <a href="/booking"><i class="bi bi-calendar-check"></i> Booking / Pemesanan</a>
          <a href="/finalisasi"><i class="bi bi-check2-square"></i> Finalisasi</a>
          <a href="/riwayat-transaksi"><i class="bi bi-clock-history"></i> Riwayat Transaksi</a>
          <a href="/riwayat-pasien"><i class="bi bi-person-lines-fill"></i> Riwayat Pasien</a>
          <a href="/tindakan"><i class="bi bi-hospital"></i> Layanan / Tindakan</a>
          <a href="/dokter"><i class="bi bi-person-badge"></i> Dokter</a>
          <a href="/suster" class="active"><i class="bi bi-heart-pulse"></i> Suster</a>
          <a href="/lembur"><i class="bi bi-stopwatch"></i> Input Lembur</a>
          <a href="/payroll"><i class="bi bi-cash-stack"></i> Payroll / Gaji</a>
          <a href="/laporan"><i class="bi bi-file-earmark-bar-graph"></i> Laporan</a>
        </nav>
      </div>
     
      <div class="sidebar-footer d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-1 overflow-hidden me-2">
          <i class="bi bi-person-circle text-success me-1"></i>
          <strong class="text-white text-truncate" title="<%= typeof user !== 'undefined' && user ? (user.nama || user.username) : 'Administrator' %>">
            <%= typeof user !== 'undefined' && user ? (user.nama || user.username) : 'Administrator' %>
          </strong>
        </div>
        <a href="/logout" class="text-danger text-decoration-none" title="Keluar">
          <i class="bi bi-box-arrow-right fs-6"></i>
        </a>
      </div>
    </div>

    <!-- KONTEN UTAMA -->
    <div class="main-content">
      <div class="header-rs-center">
        <img src="/image/logors.png" alt="Logo RS" class="logo-header" onerror="this.style.display='none'">
        <div class="text-center">
          <h1 class="header-title">RS. SAKTI MANDRA GUNA</h1>
          <p class="header-subtitle">KHUSUS BEDAH PLASTIK, KECANTIKAN & TREATMENT</p>
        </div>
      </div>

      <div class="content-body">
        <img src="/image/logors.png" alt="Watermark RS" class="watermark-bg" onerror="this.style.display='none'">

        <!-- WIDGET CONTAINER GRID SUSTER -->
        <div class="widget-container p-4">
          <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary">
            <div>
              <h5 class="fw-bold text-white mb-1">
                <i class="bi bi-heart-pulse-fill text-success me-2"></i>Daftar Suster & Perawat
              </h5>
              <p class="text-muted small mb-0">Kelola informasi perawat, fokus peran, dan foto profil staf medis rumah sakit.</p>
            </div>
            <!-- Tombol Tambah Suster -->
            <button type="button" class="btn btn-green-neon" data-bs-toggle="modal" data-bs-target="#modalTambahSuster">
              <i class="bi bi-plus-circle me-1"></i> Tambah Suster
            </button>
          </div>

          <!-- GRID CONTAINER CARD SUSTER -->
          <div class="row g-3">
            <% if (typeof susters === 'undefined' || susters.length === 0) { %>
              <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                Belum ada data suster.
              </div>
            <% } else { %>
              <% susters.forEach(s => { %>
                <% const itemId = s._id || s.id; %>
                <div class="col-md-6 col-xl-4">
                  <div class="suster-card">
                    <!-- BAGIAN ATAS: FOTO & INFORMASI (PADDING KHUSUS) -->
                    <div class="p-3">
                      <div class="d-flex align-items-center gap-3">
                        <% if (s.foto) { %>
                          <img src="/uploads/<%= s.foto %>" alt="Foto Suster" class="suster-avatar-lg">
                        <% } else { %>
                          <div class="suster-avatar-lg">
                            <i class="bi bi-person-fill"></i>
                          </div>
                        <% } %>
                        <div class="overflow-hidden">
                          <span class="card-title-neon text-truncate d-block mb-1" title="<%= s.nama %>"><%= s.nama %></span>
                          <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">
                            <%= s.peran || 'OPERASI' %>
                          </span>
                        </div>
                      </div>
                    </div>

                    <!-- BAGIAN BAWAH: TOMBOL AKSI DENGAN GARIS PEMISAH KHUSUS DI FOOTER CARD -->
                    <div class="card-footer-action">
                      <button type="button" class="btn btn-sm btn-outline-success px-3" data-bs-toggle="modal" data-bs-target="#modalEditSuster<%= itemId %>">
                        <i class="bi bi-pencil-square me-1"></i> Edit
                      </button>
                      <button type="button" class="btn btn-sm btn-outline-danger px-2" data-bs-toggle="modal" data-bs-target="#modalHapusSuster<%= itemId %>" title="Hapus">
                        <i class="bi bi-trash"></i>
                      </button>
                    </div>
                  </div>
                </div>
              <% }); %>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- SEMUA MODAL EDIT & HAPUS SUSTER -->
  <% if (typeof susters !== 'undefined' && susters.length > 0) { %>
    <% susters.forEach(s => { %>
      <% const itemId = s._id || s.id; %>
      
      <!-- MODAL EDIT SUSTER -->
      <div class="modal fade" id="modalEditSuster<%= itemId %>" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content modal-content-dark">
            <div class="modal-header border-secondary">
              <h5 class="modal-title fw-bold text-success fs-6">
                <i class="bi bi-pencil-square me-2"></i>Edit Data Suster
              </h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/suster/update/<%= itemId %>" method="POST" enctype="multipart/form-data">
              <div class="modal-body">
                <div class="mb-3">
                  <label class="modal-label-custom">Nama Suster / Perawat</label>
                  <input type="text" name="nama" class="form-control form-control-dark fw-bold text-white" value="<%= s.nama %>" required>
                </div>
                <div class="mb-3">
                  <label class="modal-label-custom">Fokus Peran Utama</label>
                  <select name="peran" class="form-select form-select-dark" required>
                    <option value="OPERASI" <%= s.peran === 'OPERASI' ? 'selected' : '' %>>OPERASI</option>
                    <option value="TREATMENT" <%= s.peran === 'TREATMENT' ? 'selected' : '' %>>TREATMENT</option>
                    <option value="JAGA" <%= s.peran === 'JAGA' ? 'selected' : '' %>>JAGA</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="modal-label-custom">Foto Profil Suster</label>
                  <input type="file" name="foto" class="form-control form-control-dark text-white" accept="image/*">
                  <small class="text-muted mt-1 d-block">Format: JPG, PNG, WEBP (Opsional)</small>
                </div>
              </div>
              <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                <button type="submit" class="btn btn-green-neon btn-sm px-4">Simpan Perubahan</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- MODAL KONFIRMASI HAPUS SUSTER -->
      <div class="modal fade" id="modalHapusSuster<%= itemId %>" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
          <div class="modal-content modal-content-dark text-center p-3">
            <div class="modal-body">
              <i class="bi bi-exclamation-triangle text-warning fs-1 mb-2 d-block"></i>
              <h6 class="fw-bold text-white mb-2">Konfirmasi Hapus</h6>
              <p class="text-white small mb-3">Apakah Anda yakin ingin menghapus suster <strong class="text-success"><%= s.nama %></strong>?</p>
              <div class="d-flex justify-content-center gap-2">
                <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Tidak</button>
                <a href="/suster/hapus/<%= itemId %>" class="btn btn-danger btn-sm px-3">Ya, Hapus</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  <% } %>

  <!-- MODAL TAMBAH SUSTER BARU -->
  <div class="modal fade" id="modalTambahSuster" tabindex="-1" aria-labelledby="modalTambahLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content modal-content-dark">
        <div class="modal-header border-secondary">
          <h5 class="modal-title fw-bold text-success fs-6" id="modalTambahLabel">
            <i class="bi bi-person-plus-fill me-2"></i>Tambah Suster Baru
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/suster/tambah" method="POST" enctype="multipart/form-data">
          <div class="modal-body">
            <div class="mb-3">
              <label class="modal-label-custom">Nama Suster / Perawat</label>
              <input type="text" name="nama" class="form-control form-control-dark text-white" required placeholder="Ns. Suster Jane">
            </div>
            <div class="mb-3">
              <label class="modal-label-custom">Fokus Peran Utama</label>
              <select name="peran" class="form-select form-select-dark" required>
                <option value="OPERASI">OPERASI</option>
                <option value="TREATMENT">TREATMENT</option>
                <option value="JAGA">JAGA</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="modal-label-custom">Foto Profil Suster</label>
              <input type="file" name="foto" class="form-control form-control-dark text-white" accept="image/*">
              <small class="text-muted mt-1 d-block">Format: JPG, PNG, WEBP (Opsional)</small>
            </div>
          </div>
          <div class="modal-footer border-secondary">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
            <button type="submit" class="btn btn-green-neon btn-sm px-4">Simpan Suster</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Bootstrap Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>