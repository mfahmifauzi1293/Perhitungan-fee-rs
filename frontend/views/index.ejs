  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
 
  <!-- SCRIPT HANDLING AJAX LOGIN & REGISTER -->
  <script>
    // Handling AJAX Login
    document.getElementById('formLoginPopup').addEventListener('submit', async function(e) {
      e.preventDefault();
 
      const username = document.getElementById('popupUsername').value;
      const password = document.getElementById('popupPassword').value;
      const alertBox = document.getElementById('loginAlert');
 
      alertBox.classList.add('d-none');
 
      try {
        const response = await fetch('/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });
 
        const result = await response.json();
 
        if (response.ok && result.success) {
          window.location.href = result.redirectUrl;
        } else {
          alertBox.innerText = result.message || 'Username atau password salah.';
          alertBox.classList.remove('d-none');
        }
      } catch (err) {
        alertBox.innerText = 'Terjadi kesalahan sistem server.';
        alertBox.classList.remove('d-none');
      }
    });
  
    // Handling AJAX Register (Pop-up)
    document.getElementById('formRegisterPopup').addEventListener('submit', async function(e) {
      e.preventDefault();
  
      const nama = document.getElementById('regNama').value;
      const username = document.getElementById('regUsername').value;
      const password = document.getElementById('regPassword').value;
      const no_hp = document.getElementById('regNoHp').value;
      const alertBox = document.getElementById('registerAlert');
  
      alertBox.classList.add('d-none');
  
      try {
        const response = await fetch('/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nama, username, password, no_hp })
        });
  
        const result = await response.json();
  
        if (response.ok && result.success) {
          alertBox.className = 'alert alert-success text-center py-2 fs-6 mb-3';
          alertBox.innerText = result.message || 'Pendaftaran berhasil! Silakan login.';
          alertBox.classList.remove('d-none');
         
          setTimeout(() => {
            const registerModalEl = document.getElementById('registerModal');
            const registerModal = bootstrap.Modal.getInstance(registerModalEl);
            if (registerModal) registerModal.hide();
           
            const loginModalEl = new bootstrap.Modal(document.getElementById('loginModal'));
            loginModalEl.show();
          }, 1500);
        } else {
          alertBox.className = 'alert alert-danger text-center py-2 fs-6 mb-3';
          alertBox.innerText = result.message || 'Gagal mendaftar. Silakan coba lagi.';
          alertBox.classList.remove('d-none');
        }
      } catch (err) {
        // Fallback jika backend melakukan form post standar/redirect
        this.submit();
      }
    });
  </script>
