<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Riwayat Transaksi - RS Sakti Mandra Guna</title>
 
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
 
  <!-- CSS Bootstrap 5 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
 
  <style>
    :root {
      --bg-dark: #0d1117;
      --card-bg: #161b22;
      --sidebar-bg: #161b22;
      --border-color: #30363d;
      --accent-green: #2ea043;
      --accent-green-neon: #39FF14;
      --text-main: #c9d1d9;
      --text-heading: #ffffff;
      --text-sub: #8b949e;
    }

    body, html {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    .app-container {
      display: flex;
      min-height: 100vh;
    }

    /* SIDEBAR NAVIGASI */
    .sidebar {
      width: 250px;
      min-height: 100vh;
      background: var(--sidebar-bg);
      color: #ffffff;
      border-right: 1px solid var(--border-color);
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 20;
    }

    .sidebar-header {
      background: #010409;
      color: #ffffff;
      border-bottom: 1px solid var(--border-color);
      font-size: 0.85rem;
      padding: 16px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
      letter-spacing: 1px;
    }

    .logo-menu {
      height: 30px;
      width: auto;
    }

    .sidebar nav a {
      color: var(--text-sub);
      text-decoration: none;
      padding: 10px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 500;
      font-size: 0.875rem;
      transition: all 0.2s ease;
      border-left: 3px solid transparent;
    }

    .sidebar nav a:hover {
      background: rgba(255, 255, 255, 0.03);
      color: #ffffff;
    }

    .sidebar nav a.active {
      background: rgba(46, 160, 67, 0.15);
      color: var(--accent-green-neon);
      border-left-color: var(--accent-green-neon);
      font-weight: 600;
    }

    .sidebar-footer {
      padding: 14px 18px;
      font-size: 0.8rem;
      color: var(--text-sub);
      border-top: 1px solid var(--border-color);
      background: #010409;
    }

    /* MAIN CONTENT */
    .main-content {
      flex-grow: 1;
      position: relative;
      min-height: 100vh;
      background-color: var(--bg-dark);
    }

    .header-rs-center {
      background: var(--card-bg);
      padding: 18px 24px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
    }

    .logo-header {
      height: 48px;
      width: auto;
    }

    .header-title {
      color: var(--accent-green-neon);
      font-weight: 700;
      font-size: 1.35rem;
      margin: 0;
      letter-spacing: 0.5px;
    }

    .header-subtitle {
      color: var(--text-sub);
      font-size: 0.72rem;
      margin: 2px 0 0 0;
      letter-spacing: 1px;
    }

    .content-body {
      padding: 24px;
      position: relative;
    }

    .watermark-bg {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 450px;
      max-width: 70%;
      opacity: 0.04;
      pointer-events: none;
      z-index: 0;
    }

    .widget-container {
      border: 1px solid var(--border-color);
      background-color: var(--card-bg);
      border-radius: 12px;
      overflow: hidden;
      height: 100%;
      position: relative;
      z-index: 1;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .widget-header {
      background-color: rgba(255, 255, 255, 0.02);
      color: var(--text-heading);
      padding: 14px 20px;
      font-weight: 600;
      font-size: 0.95rem;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .table-dark-custom {
      --bs-table-bg: transparent !important;
      --bs-table-color: var(--text-main) !important;
      width: 100%;
      margin-bottom: 0;
      font-size: 0.875rem;
    }

    .table-dark-custom th {
      background-color: rgba(0, 0, 0, 0.25) !important;
      color: var(--accent-green-neon) !important;
      border-bottom: 1px solid var(--border-color) !important;
      padding: 12px 16px;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .table-dark-custom td {
      border-bottom: 1px solid var(--border-color) !important;
      padding: 12px 16px;
    }

    .form-control-dark {
      background-color: #0d1117 !important;
      border: 1px solid var(--border-color) !important;
      color: #ffffff !important;
      font-size: 0.875rem;
      color-scheme: dark;
    }

    .form-control-dark:focus {
      background-color: #0d1117 !important;
      border-color: var(--accent-green) !important;
      color: #ffffff !important;
      box-shadow: 0 0 0 0.25rem rgba(46, 160, 67, 0.25);
    }

    .btn-outline-neon {
      border: 1px solid var(--accent-green-neon);
      color: var(--accent-green-neon);
      background: transparent;
      font-size: 0.8rem;
      padding: 4px 10px;
      border-radius: 6px;
    }

    .btn-outline-neon:hover {
      background-color: var(--accent-green-neon);
      color: #000000;
    }

    .modal-content-dark {
      background-color: #161b22;
      border: 1px solid var(--border-color);
      color: var(--text-main);
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
    }

    .modal-content-dark .modal-header {
      border-bottom: 1px solid var(--border-color);
      background-color: #010409;
      color: #ffffff;
    }

    .modal-content-dark .modal-footer {
      border-top: 1px solid var(--border-color);
      background-color: #010409;
    }

    .list-group-dark .list-group-item {
      background-color: transparent;
      border-color: var(--border-color);
      color: var(--text-main);
    }
  </style>
</head>
<body>

  <div class="app-container">
    <!-- SIDEBAR NAVIGASI ADMINISTRATOR -->
    <div class="sidebar">
      <div>
        <div class="sidebar-header">
          <img src="/image/logors.png" alt="Logo RS" class="logo-menu" onerror="this.style.display='none'">
          <span>MENU UTAMA</span>
        </div>
        <nav>
          <a href="/"><i class="bi bi-house-door"></i> Beranda</a>
          <a href="/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
          <a href="/booking"><i class="bi bi-calendar-check"></i> Booking / Pemesanan</a>
          <a href="/finalisasi"><i class="bi bi-check2-square"></i> Finalisasi</a>
          <a href="/riwayat-transaksi" class="active"><i class="bi bi-clock-history"></i> Riwayat Transaksi</a>
          <a href="/riwayat-pasien"><i class="bi bi-person-lines-fill"></i> Riwayat Pasien</a>
          <a href="/tindakan"><i class="bi bi-hospital"></i> Layanan / Tindakan</a>
          <a href="/dokter"><i class="bi bi-person-badge"></i> Dokter</a>
          <a href="/suster"><i class="bi bi-heart-pulse"></i> Suster</a>
          <a href="/lembur"><i class="bi bi-stopwatch"></i> Input Lembur</a>
          <a href="/payroll"><i class="bi bi-cash-stack"></i> Payroll / Gaji</a>
          <a href="/laporan"><i class="bi bi-file-earmark-bar-graph"></i> Laporan</a>
        </nav>
      </div>
     
      <div class="sidebar-footer d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-1 overflow-hidden me-2">
          <i class="bi bi-person-circle text-success me-1"></i>
          <strong class="text-white text-truncate" title="<%= typeof user !== 'undefined' && user ? (user.nama || user.username) : 'Administrator' %>">
            <%= typeof user !== 'undefined' && user ? (user.nama || user.username) : 'Administrator' %>
          </strong>
        </div>
        <a href="/logout" class="text-danger text-decoration-none" title="Keluar">
          <i class="bi bi-box-arrow-right fs-6"></i>
        </a>
      </div>
    </div>

    <!-- KONTEN UTAMA -->
    <div class="main-content">
      <div class="header-rs-center">
        <img src="/image/logors.png" alt="Logo RS" class="logo-header" onerror="this.style.display='none'">
        <div class="text-center">
          <h1 class="header-title">RS. SAKTI MANDRA GUNA</h1>
          <p class="header-subtitle">KHUSUS BEDAH PLASTIK, KECANTIKAN & TREATMENT</p>
        </div>
      </div>

      <div class="content-body">
        <img src="/image/logors.png" alt="Watermark RS" class="watermark-bg" onerror="this.style.display='none'">

        <!-- WIDGET CONTAINER RIWAYAT TRANSAKSI -->
        <div class="widget-container">
          <div class="widget-header d-flex justify-content-between align-items-center flex-wrap gap-2 py-3">
            <span><i class="bi bi-clock-history text-success me-2"></i> Riwayat Transaksi Selesai (Completed)</span>
            
            <!-- Form Filter Tanggal & Search -->
            <form action="/riwayat-transaksi" method="GET" class="d-flex align-items-center flex-wrap gap-2">
              <div class="d-flex align-items-center gap-1">
                <small class="text-white fw-semibold">Dari:</small>
                <input type="date" name="tanggal_mulai" class="form-control form-control-dark form-control-sm" value="<%= typeof tanggal_mulai !== 'undefined' ? tanggal_mulai : '' %>">
              </div>
              <div class="d-flex align-items-center gap-1">
                <small class="text-white fw-semibold">S/d:</small>
                <input type="date" name="tanggal_selesai" class="form-control form-control-dark form-control-sm" value="<%= typeof tanggal_selesai !== 'undefined' ? tanggal_selesai : '' %>">
              </div>
              <div class="input-group input-group-sm" style="width: 200px;">
                <input type="text" name="search" class="form-control form-control-dark" placeholder="Cari pasien..." value="<%= typeof search !== 'undefined' ? search : '' %>">
                <button type="submit" class="btn btn-outline-neon"><i class="bi bi-search"></i></button>
              </div>
              <% if ((typeof search !== 'undefined' && search) || (typeof tanggal_mulai !== 'undefined' && tanggal_mulai) || (typeof tanggal_selesai !== 'undefined' && tanggal_selesai)) { %>
                <a href="/riwayat-transaksi" class="btn btn-outline-secondary btn-sm" title="Reset Filter"><i class="bi bi-x-lg"></i></a>
              <% } %>
            </form>
          </div>
         
          <div class="table-responsive">
            <table class="table table-dark-custom align-middle">
              <thead>
                <tr>
                  <th class="text-center" style="width: 50px;">No</th>
                  <th>Tgl Tindakan</th>
                  <th>Nama Pasien</th>
                  <th>Jenis Tindakan</th>
                  <th>Tim Dokter</th>
                  <th>Total Nett</th>
                  <th>Jasa RS (30%)</th>
                  <th class="text-center">Detail Split</th>
                </tr>
              </thead>
              <tbody>
                <% if (typeof transaksis === 'undefined' || !transaksis || transaksis.length === 0) { %>
                  <tr>
                    <td colspan="8" class="text-center py-4 text-muted">Belum ada transaksi yang difinalisasi.</td>
                  </tr>
                <% } else { %>
                  <% transaksis.forEach((t, index) => { %>
                    <% const itemId = t.id || t._id; %>
                    <tr>
                      <td class="text-center"><%= ((typeof currentPage !== 'undefined' ? currentPage : 1) - 1) * 50 + (index + 1) %></td>
                      <td><%= t.tanggal_tindakan ? new Date(t.tanggal_tindakan).toLocaleDateString('id-ID') : '-' %></td>
                      <td><strong class="text-white"><%= t.nama_pasien || '-' %></strong></td>
                      <td><span class="badge bg-info text-dark"><%= t.jenis_tindakan || '-' %></span></td>
                      <td>
                        <small style="font-size: 0.8rem; line-height: 1.4; display: block;">
                          <strong class="text-white">Dokter 1:</strong> <%= t.nama_dokter1 || '-' %> (<%= t.persen_dokter1 || 100 %>%)<br>
                          <% if (t.nama_dokter2) { %>
                            <strong class="text-white">Dokter 2:</strong> <%= t.nama_dokter2 %> (<%= t.persen_dokter2 || 0 %>%)<br>
                          <% } %>
                          <% if (t.nama_dokter_anestesi) { %>
                            <strong class="text-white">Anestesi:</strong> <%= t.nama_dokter_anestesi %><br>
                          <% } %>
                        </small>
                      </td>
                      <td class="fw-bold text-success font-monospace">Rp <%= Math.round(Number(t.total_nett || 0)).toLocaleString('id-ID') %></td>
                      <td class="fw-bold text-primary font-monospace">Rp <%= Math.round(Number(t.bagian_rs_30 || 0)).toLocaleString('id-ID') %></td>
                      <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalDetail<%= itemId %>">
                          <i class="bi bi-search me-1"></i> Rincian Fee
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Navigasi Pagination Halaman (Maks. 50 Baris/Halaman) -->
          <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <div class="d-flex justify-content-between align-items-center p-3 border-top border-secondary bg-dark">
              <small class="text-white">Menampilkan Halaman <strong><%= currentPage %></strong> dari <strong><%= totalPages %></strong> (Maks. 50 baris/halaman)</small>
              <nav>
                <ul class="pagination pagination-sm mb-0">
                  <% for(let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                      <a class="page-link bg-dark text-white border-secondary <%= i === currentPage ? 'bg-success border-success' : '' %>" 
                         href="/riwayat-transaksi?page=<%= i %><%= typeof search !== 'undefined' && search ? '&search=' + search : '' %><%= typeof tanggal_mulai !== 'undefined' && tanggal_mulai ? '&tanggal_mulai=' + tanggal_mulai : '' %><%= typeof tanggal_selesai !== 'undefined' && tanggal_selesai ? '&tanggal_selesai=' + tanggal_selesai : '' %>">
                         <%= i %>
                      </a>
                    </li>
                  <% } %>
                </ul>
              </nav>
            </div>
          <% } %>

        </div>
      </div>
    </div>
  </div>

  <!-- MODAL CONTAINER (DITARUH DI LUAR CONTAINER UTAMA) -->
  <% if (typeof transaksis !== 'undefined' && transaksis && transaksis.length > 0) { %>
    <% transaksis.forEach((t) => { %>
      <%
        const itemId = t.id || t._id;
        const jamMasuk = t.jam_masuk_ok || '-';
        const jamKeluar = t.jam_keluar_ok || '-';
        const durasiJam = Number(t.durasi_operasi_jam || 0);
        const tarifPerJam = Number(t.tarif_kamar_per_jam || 0);
        const totalSewaKamar = (tarifPerJam > 0 && durasiJam > 0) ? (tarifPerJam * durasiJam) : Number(t.biaya_ruang_operasi || 0);
      %>
      <div class="modal fade text-start" id="modalDetail<%= itemId %>" tabindex="-1" aria-labelledby="modalLabel<%= itemId %>" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
          <div class="modal-content modal-content-dark">
            <div class="modal-header">
              <h5 class="modal-title fs-6 text-white fw-bold" id="modalLabel<%= itemId %>">
                <i class="bi bi-receipt me-2 text-success"></i>Rincian Split Fee Transaksi #<%= itemId %>
              </h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="mb-2">
                <span class="text-muted">Pasien:</span> <strong class="text-white me-3"><%= t.nama_pasien || '-' %></strong>
                <span class="text-muted">Tindakan:</span> <strong class="text-white"><%= t.jenis_tindakan || '-' %></strong>
              </div>
              <hr class="border-secondary my-2">
             
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Total Gross:</span>
                <span class="text-white font-monospace">Rp <%= Math.round(Number(t.total_harga || 0)).toLocaleString('id-ID') %></span>
              </div>
              <div class="d-flex justify-content-between mb-1 text-danger">
                <span>Diskon:</span>
                <span class="font-monospace">Rp <%= Math.round(Number(t.diskon || 0)).toLocaleString('id-ID') %></span>
              </div>
              <div class="d-flex justify-content-between mb-3 fw-bold text-success border-bottom border-secondary pb-2">
                <span>Total Nett:</span>
                <span class="font-monospace">Rp <%= Math.round(Number(t.total_nett || 0)).toLocaleString('id-ID') %></span>
              </div>

              <h6 class="fw-bold mt-3 text-white style-sm mb-2">Rincian Pembagian (Fee Split):</h6>
              <ul class="list-group list-group-flush list-group-dark small">
                <!-- PORSI RS -->
                <li class="list-group-item d-flex justify-content-between px-0">
                  <span>Porsi Rumah Sakit (30%)</span>
                  <strong class="text-primary font-monospace">Rp <%= Math.round(Number(t.bagian_rs_30 || 0)).toLocaleString('id-ID') %></strong>
                </li>

                <!-- TIM DOKTER -->
                <li class="list-group-item d-flex justify-content-between px-0">
                  <span>Porsi Dokter Utama (<%= t.nama_dokter1 || '-' %> - <%= t.persen_dokter1 || 100 %>%)</span>
                  <strong class="text-white font-monospace">Rp <%= Math.round(Number(t.fee_dokter1 || 0)).toLocaleString('id-ID') %></strong>
                </li>
                <% if (t.nama_dokter2) { %>
                  <li class="list-group-item d-flex justify-content-between px-0">
                    <span>Porsi Dokter 2 (<%= t.nama_dokter2 %> - <%= t.persen_dokter2 || 0 %>%)</span>
                    <strong class="text-white font-monospace">Rp <%= Math.round(Number(t.fee_dokter2 || 0)).toLocaleString('id-ID') %></strong>
                  </li>
                <% } %>
               
                <% if (t.dokter_anestesi_id || Number(t.biaya_anestesi || 0) > 0) { %>
                  <li class="list-group-item d-flex justify-content-between px-0">
                    <span>Fee Dokter Anestesi <%= t.nama_dokter_anestesi ? '(' + t.nama_dokter_anestesi + ')' : '' %></span>
                    <strong class="text-white font-monospace">Rp <%= Math.round(Number(t.biaya_anestesi || 0)).toLocaleString('id-ID') %></strong>
                  </li>
                <% } %>

                <% if (t.suster_op1_id) { %>
                  <li class="list-group-item d-flex justify-content-between px-0">
                    <span>Fee Suster OP 1 <%= t.nama_suster_op1 ? '(' + t.nama_suster_op1 + ')' : '' %></span>
                    <strong class="text-white font-monospace">Rp <%= Math.round(Number(t.biaya_suster_op || 0)).toLocaleString('id-ID') %></strong>
                  </li>
                <% } %>
                <% if (t.suster_op2_id) { %>
                  <li class="list-group-item d-flex justify-content-between px-0">
                    <span>Fee Suster OP 2 <%= t.nama_suster_op2 ? '(' + t.nama_suster_op2 + ')' : '' %></span>
                    <strong class="text-white font-monospace">Rp <%= Math.round(Number(t.biaya_suster_op || 0)).toLocaleString('id-ID') %></strong>
                  </li>
                <% } %>
                <% if (t.suster_op3_id) { %>
                  <li class="list-group-item d-flex justify-content-between px-0">
                    <span>Fee Suster OP 3 <%= t.nama_suster_op3 ? '(' + t.nama_suster_op3 + ')' : '' %></span>
                    <strong class="text-white font-monospace">Rp <%= Math.round(Number(t.biaya_suster_op || 0)).toLocaleString('id-ID') %></strong>
                  </li>
                <% } %>

                <% if (t.suster_rawat_id || Number(t.biaya_suster_rawat || 0) > 0) { %>
                  <li class="list-group-item d-flex justify-content-between px-0">
                    <span>Fee Suster Jaga/Rawat</span>
                    <strong class="text-white font-monospace">Rp <%= Math.round(Number(t.biaya_suster_rawat || 0)).toLocaleString('id-ID') %></strong>
                  </li>
                <% } %>

                <li class="list-group-item d-flex justify-content-between px-0">
                  <span>
                    Sewa Kamar OK
                    <% if (jamMasuk !== '-' && jamKeluar !== '-') { %>
                      (<%= jamMasuk %> - <%= jamKeluar %> | <%= durasiJam %> jam)
                    <% } else if (durasiJam > 0) { %>
                      (<%= durasiJam %> jam)
                    <% } %>
                  </span>
                  <strong class="text-white font-monospace">Rp <%= Math.round(totalSewaKamar).toLocaleString('id-ID') %></strong>
                </li>

                <li class="list-group-item d-flex justify-content-between px-0">
                  <span>Obat / Alkes</span>
                  <strong class="text-white font-monospace">Rp <%= Math.round(Number(t.biaya_obat || 0)).toLocaleString('id-ID') %></strong>
                </li>
              </ul>
            </div>
           
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                <i class="bi bi-x-circle me-1"></i> Tutup
              </button>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  <% } %>

  <!-- Bootstrap Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>